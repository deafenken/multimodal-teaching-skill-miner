{
  "schema": "teaching_skill_miner.teacher_agent_benchmark_v2.v1",
  "benchmark_version": "2.0",
  "benchmark_id": "teacher_agent_product_v2_development",
  "split": "development",
  "description": "Input-only development fixture for long-horizon memory, misconception resolution, Skill switching, prompt-injection resistance, cross-session isolation, and outcome-measurement plumbing. Gold is stored separately.",
  "goals": {
    "dynamic_programming": {
      "concept": "动态规划的状态与转移",
      "objective": "学习者能够定义状态、写出状态转移并判断一个新问题是否适合动态规划。",
      "knowledge_components": ["递归分解", "状态定义", "状态转移", "边界与计算顺序", "迁移判定"],
      "success_thresholds": {"prerequisite": 0.6, "conceptual": 0.65, "procedural": 0.6, "transfer": 0.55},
      "max_rounds": 12,
      "materials": {
        "example": "爬 4 级楼梯，每次走 1 级或 2 级，问共有多少种走法",
        "practice": "写出 dp[i] 的含义与转移来源",
        "transfer_task": "把状态定义迁移到最少硬币问题"
      },
      "knowledge_spec": {
        "canonical_claims": [
          {
            "claim_id": "state_transition_includes_all_last_steps",
            "statement": "每次可走 1 级或 2 级时，到达第 i 级的状态转移必须同时考虑 i-1 和 i-2 两类最后一步来源。",
            "knowledge_components": ["状态转移"]
          }
        ],
        "misconception_catalog": [
          {
            "tag": "missing_second_transition",
            "aliases": [
              "dp_transition_only_one_step",
              "dp_transition_ignores_two_steps"
            ],
            "description": "忽略最后走两级这一类合法来源，把状态转移错误地限制为只看前一状态。",
            "contradicts_claim_ids": ["state_transition_includes_all_last_steps"],
            "corrective_principle": "按最后一步的全部合法情况划分，并检查边界。"
          }
        ]
      }
    }
  },
  "student_profiles": {
    "memory_profile_a": {
      "profile_ref": "memory_profile_a",
      "learner_level": "beginner",
      "preferences": ["先用小例子，再写公式"],
      "accessibility_needs": [],
      "initial_mastery": {"prerequisite": 0.45, "conceptual": 0.2, "procedural": 0.1, "transfer": 0.05},
      "known_misconceptions": [],
