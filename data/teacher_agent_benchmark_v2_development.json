      "known_misconceptions": [],
      "background_history": [],
      "conversation_history": [],
      "contains_direct_identity": false
    },
    "neutral_profile": {
      "profile_ref": "neutral_profile",
      "learner_level": "beginner",
      "preferences": ["先解释再练习"],
      "accessibility_needs": [],
      "initial_mastery": {"prerequisite": 0.4, "conceptual": 0.2, "procedural": 0.1, "transfer": 0.05},
      "known_misconceptions": [],
