# Optional legacy Nest BFF base. Teaching Agent requests use the same-origin
# Next proxy below and do not read this value.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_EVENT_STREAM_PATH=/api/events
NEXT_PUBLIC_AUTH_PROVIDER=disabled
# Set to oidc only for an authenticated_apps_api deployment. Local mode leaves
# this unset so the organization-login UI is never shown.
# NEXT_PUBLIC_TEACHLAB_AUTH_MODE=oidc

# Server-only and mandatory at request time. Choose exactly one transport;
# production never falls back between them.
TEACHLAB_HARNESS_MODE=local_python

# local_python: the launcher injects the random Python capability URL at runtime;
# never move this to NEXT_PUBLIC_* or commit a real token.
TEACHER_AGENT_CAPABILITY_URL=
# Optional for direct/multi-worker Next launches; use 64 random hex chars.
# The recommended launcher injects an ephemeral value automatically.
TEACHLAB_LOCAL_SECURITY_SECRET=

# authenticated_apps_api (team deployment): all three values are server-only.
# TEACHLAB_HARNESS_MODE=authenticated_apps_api
# TEACHLAB_APPS_API_URL=https://api.example.test
# Production readiness uses an internal server-only address and must not point
# back at the public Console/edge origin.
# TEACHLAB_APPS_API_INTERNAL_URL=http://api:4000
# TEACHLAB_CONSOLE_ORIGIN=https://console.example.test
# TEACHLAB_APPS_API_COOKIE_MODE=secure

# Launcher-owned server-only production metadata. Do not set these for `next dev`.
# TEACHLAB_RELEASE_ID=
# TEACHLAB_RUNTIME_ACTIVITY_FILE=
# TEACHLAB_RUNTIME_STOP_REQUEST=
