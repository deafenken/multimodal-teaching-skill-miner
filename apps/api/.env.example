NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGINS=http://localhost:3000

# Local-only identity. Protected routes trust only the server-minted Cookie, never
# these headers directly. Header overrides are for isolated tests and stay off.
AUTH_MODE=development
DEV_AUTH_USER_ID=local-developer
DEV_AUTH_TENANT_ID=local-tenant
DEV_AUTH_ALLOW_HEADERS=false
# Omit locally to generate an ephemeral per-process key. Production accepts
# only an owned mode-0600 file under an owned mode-0700 directory.
# SESSION_SECRET=replace-with-at-least-32-random-characters
# SESSION_SECRET_FILE=/run/teachlab/session-secret
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
SEED_DEMO_SESSIONS=true

# Local defaults are deliberately non-production. A production process refuses to
# start unless AUTH_MODE=oidc, DATA_BACKEND=postgres, secure cookies, verify-full
# TLS, exact HTTPS CORS origins, and all required OIDC/Postgres settings are present.
DATA_BACKEND=memory
# DATABASE_URL=postgresql://teachlab_app:password@db.example.test/teachlab
# DATABASE_URL_FILE=/run/teachlab/database-url
# Apply migrations/001_tenant_rls.sql then 002_auth_session_revocation.sql with
# a separate owner before startup. Production readiness requires all four
# FORCE-RLS tables and the exact hash-only auth-session columns.
# PG_SSL_MODE=verify-full
# PG_POOL_MAX=10
# OIDC_ISSUER=https://identity.example.test
# OIDC_AUDIENCE=teachlab-api
# OIDC_CLIENT_ID=teachlab-console
# OIDC_CLIENT_SECRET_FILE=/run/teachlab/oidc-client-secret
# OIDC_REDIRECT_URI=https://console.example.test/api/teacher-agent/security/login/callback
# OIDC_TRANSACTION_SECRET_FILE=/run/teachlab/oidc-transaction-secret
# OIDC_EXPECTED_HOST=api.example.test
# OIDC_TRANSACTION_TTL_SECONDS=300
# OIDC_AUTHENTICATION_MAX_AGE_SECONDS=3600
# Full account export and permanent deletion require a fresh IdP assertion
# whose exact acr is in this AAL2 allowlist. A normal signed session is not
# sufficient authority for either operation.
# OIDC_ACCOUNT_STEP_UP_MAX_AGE_SECONDS=300
# OIDC_ACCOUNT_AAL2_ACR_VALUES=urn:teachlab:aal2
# The three privileged teacher mutations consult this authoritative directory
# before any worker is acquired. Cookie roles are ignored. Production accepts
# the Bearer credential and the two independent HMAC keys only from private
# files; with no revocation-event consumer, cache TTL is capped at 5000 ms.
# TEACHER_ENTITLEMENT_DIRECTORY_URL=https://entitlements.organization.example/v1/teacher/snapshot
# TEACHER_ENTITLEMENT_DIRECTORY_BEARER_SECRET_FILE=/run/teachlab/teacher-entitlement-directory-bearer
# TEACHER_ENTITLEMENT_BINDING_KEY_FILE=/run/teachlab/teacher-entitlement-binding-key
# TEACHER_ENTITLEMENT_RECEIPT_KEY_FILE=/run/teachlab/teacher-entitlement-receipt-key
# TEACHER_ENTITLEMENT_POLICY_ID=teacher-mutations
# TEACHER_ENTITLEMENT_POLICY_VERSION=roles-v7
# TEACHER_ENTITLEMENT_FRESHNESS_TTL_MS=30000
# TEACHER_ENTITLEMENT_CACHE_TTL_MS=5000
# TEACHER_ENTITLEMENT_PROVIDER_TIMEOUT_MS=2000
# TEACHER_ENTITLEMENT_MAX_RESPONSE_BYTES=65536
# TEACHER_ENTITLEMENT_MAX_CLOCK_SKEW_MS=5000
# TEACHER_ENTITLEMENT_MAX_CACHE_ENTRIES=10000
# TEACHER_ENTITLEMENT_MIN_ASSURANCE_LEVEL=2
# OIDC_TENANT_CLAIM=org_id
# OIDC_ROLES_CLAIM=roles
# These two signed IdP claims are server-only. The state claim accepts exactly
# denied|adult_roster_authorized|minor_guardian_verified|
# minor_school_policy_verified and only when its version equals the configured
# policy version. Missing, unknown, or stale claims are normalized to denied.
# OIDC_REMOTE_PROCESSING_POLICY_CLAIM=teachlab_remote_processing_policy
# OIDC_REMOTE_PROCESSING_POLICY_VERSION_CLAIM=teachlab_remote_processing_policy_version
# REMOTE_SUBJECT_POLICY_ID=school-remote-processing
# REMOTE_SUBJECT_POLICY_VERSION=2026-08-12
# OIDC_ALLOWED_ALGORITHMS=RS256
# SESSION_PREVIOUS_SECRET_FILE=/run/teachlab/session-previous-secret

# Account identity/tombstone/cache namespaces are issuer+tenant+subject bound
# on the server and never exposed as raw browser identity. Production requires
# distinct private files; preserve old account scope keys while tombstones from
# that version must still fence re-enrollment.
ACCOUNT_SCOPE_KEY_VERSION=k1
# ACCOUNT_SCOPE_SECRET_FILE=/run/teachlab/account-scope-secret
# ACCOUNT_PREVIOUS_SCOPE_KEYS_FILE=/run/teachlab/account-previous-scope-keys
ACCOUNT_IDENTITY_NAMESPACE_VERSION=ns1
# ACCOUNT_IDENTITY_NAMESPACE_SECRET_FILE=/run/teachlab/account-identity-namespace-secret
# ACCOUNT_DELETION_STATUS_SECRET_FILE=/run/teachlab/account-deletion-status-secret
# ACCOUNT_CACHE_SCOPE_SECRET_FILE=/run/teachlab/account-cache-scope-secret
ACCOUNT_CACHE_SCOPE_EPOCH=epoch1

# The BFF exposes the model boundary but deliberately does not execute model calls.
MODEL_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5
SSE_HEARTBEAT_MS=15000
EVENT_POLL_MS=1000

# Authenticated Python Teaching Harness gateway. Production requires this
# boundary to be enabled and every value below to be explicit. Each signed
# tenant+owner scope receives a separate process and mode-0700 store root.
HARNESS_GATEWAY_ENABLED=false
# HARNESS_WORKER_ROOT=/var/lib/teachlab/harness-workers
# HARNESS_WORKER_CWD=/opt/teachlab/application
# HARNESS_WORKER_FILESYSTEM_ISOLATION_REQUIRED=true
# Linux production requires these four exact per-process limits. They are sent
# only in the private worker bootstrap; local workers with isolation disabled
# leave process_resource_limits null.
# HARNESS_WORKER_RLIMIT_CORE_BYTES=0
# HARNESS_WORKER_RLIMIT_NOFILE=256
# HARNESS_WORKER_RLIMIT_FSIZE_BYTES=536870912
# HARNESS_WORKER_RLIMIT_AS_BYTES=1610612736
# Trusted server-side locale used only for safeguarding resource policy.
# HARNESS_SAFEGUARDING_LOCALE=zh-CN
# The institutional receiver and its independent mode-0600 Bearer file are
# server-only. Production verifies this content-free dependency on /ready.
# HARNESS_SAFEGUARDING_DISPATCH_URL=https://safeguarding.organization.example/v1/cases
# HARNESS_SAFEGUARDING_DISPATCH_BEARER_SECRET_FILE=/run/teachlab/safeguarding-dispatch-bearer
# HARNESS_SAFEGUARDING_DISPATCH_POLICY_VERSION=school-routing-v1
# HARNESS_SAFEGUARDING_DISPATCH_TIMEOUT_MS=5000
# HARNESS_SAFEGUARDING_DISPATCH_MAX_RESPONSE_BYTES=32768
# Production enables only an explicit closed-case retention policy. The
# authority file is independent of dispatcher/provider/scope/session secrets,
# mode 0600 in the mode-0700 private directory, and stable across restarts.
# HARNESS_SAFEGUARDING_RETENTION_POLICY_VERSION=closed-case-retention-v1
# HARNESS_SAFEGUARDING_RETENTION_MINIMUM_CLOSED_AGE_SECONDS=7776000
# HARNESS_SAFEGUARDING_RETENTION_MAXIMUM_CASES_PER_RUN=128
# HARNESS_SAFEGUARDING_RETENTION_AUTHORITY_SECRET_FILE=/run/teachlab/safeguarding-retention-authority
# HARNESS_SAFEGUARDING_RETENTION_DEPLOYMENT_CONTEXT_SHA256=<64-lowercase-hex>
# HARNESS_WORKER_PYTHON=/opt/teachlab/runtime/bin/python
HARNESS_WORKER_BACKEND=deterministic
HARNESS_SCOPE_KEY_VERSION=k1
# HARNESS_SCOPE_SECRET_FILE=/run/teachlab/harness-scope-secret
# During rotation, keep prior keys until every opaque scope directory has been
# atomically copied, fsynced, verified and rewrapped under the active key.
# Values are never sent to a browser or child env.
# HARNESS_PREVIOUS_SCOPE_KEYS_FILE=/run/teachlab/harness-previous-scope-keys
# METRICS_TOKEN_FILE=/run/teachlab/metrics-token
HARNESS_MAX_WORKERS=16
HARNESS_WORKER_STARTUP_MS=20000
HARNESS_WORKER_SHUTDOWN_MS=5000
HARNESS_WORKER_IDLE_TIMEOUT_MS=900000
HARNESS_RESPONSE_MAX_BYTES=33554432
# Exact roles required in the fresh authoritative directory snapshot for all
# three privileged routes. These are never taken from a browser session.
# The worker assertion proves deployment authorization, not a person's
# non-repudiable signature.
TEACHER_AUTHORITY_ROLES=teacher
TEACHER_AUTHORITY_TTL_SECONDS=120
# Test/development identity remains non-teacher unless explicitly changed.
DEV_AUTH_ROLES=developer
# Remote mode is opt-in and fails startup without a private, non-symlink file.
# HARNESS_PROVIDER_API_KEY_FILE=/run/secrets/deepseek-api-key
# DeepSeek startup also requires this complete deployment-owned policy. Values
# are bound into consent receipts; they are not provider guarantees verified by
# this repository and must match the operator's approved external terms.
# HARNESS_PROVIDER_POLICY_ID=deepseek-approved-terms
# HARNESS_PROVIDER_POLICY_VERSION=2026-08-12
# HARNESS_PROVIDER_PROCESSING_REGION=cn_north
# HARNESS_PROVIDER_RETENTION_DAYS=7
# HARNESS_PROVIDER_DELETION_STATUS=outside_service_control_subject_to_provider_policy
# HARNESS_PROVIDER_DOCUMENTATION_URL=https://provider.example/privacy
