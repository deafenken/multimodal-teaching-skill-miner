{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:teaching-skill-episode-receipt:1",
  "title": "Episode Skill mining receipt",
  "type": "object",
  "required": ["schema", "artifact_kind", "episode_manifest_sha256", "manifest_path", "video_count", "episode_count", "evaluation_passed_count", "internal_evaluation_is_accuracy", "claim_boundary"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.episode_receipt.v1"},
    "artifact_kind": {"const": "episode_skill_mining_receipt"},
    "episode_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_path": {"type": "string", "minLength": 1},
    "video_count": {"type": "integer", "minimum": 0},
    "episode_count": {"type": "integer", "minimum": 0},
    "evaluation_passed_count": {"type": "integer", "minimum": 0},
    "internal_evaluation_is_accuracy": {"const": false},
    "claim_boundary": {"$ref": "teaching_skill_episode_manifest.schema.json#/properties/claim_boundary"}
  },
  "additionalProperties": true
}
