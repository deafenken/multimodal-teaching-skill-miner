{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_free_text_benchmark.schema.json",
  "title": "Teacher Agent author-constructed Chinese free-text diagnosis benchmark",
  "type": "object",
  "required": [
    "schema",
    "description",
    "label_taxonomy",
    "split_policy",
    "cases",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "teaching_skill_miner.teacher_agent_free_text_benchmark.v1"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "label_taxonomy": {
      "type": "object",
      "required": [
        "correct",
        "partial",
        "misconception",
        "confused",
        "no_response",
        "off_topic",
        "valid_alternative"
      ],
      "properties": {
        "correct": {"type": "string", "minLength": 1},
        "partial": {"type": "string", "minLength": 1},
        "misconception": {"type": "string", "minLength": 1},
        "confused": {"type": "string", "minLength": 1},
        "no_response": {"type": "string", "minLength": 1},
        "off_topic": {"type": "string", "minLength": 1},
        "valid_alternative": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "split_policy": {
      "type": "object",
      "required": ["primary_split_unit", "grouping_keys", "leakage_rule"],
      "properties": {
        "primary_split_unit": {"const": "learner_id"},
        "grouping_keys": {
          "const": ["learner_id", "session_id", "problem_id", "kc_id"]
        },
        "leakage_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/case"}
    },
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 2,
      "maxLength": 96
    },
    "signal": {
      "enum": [
        "correct",
        "partial",
        "misconception",
        "confused",
        "no_response",
        "off_topic",
        "valid_alternative"
      ]
    },
    "primarySkillId": {
      "enum": [
        "skill_diagnostic_questioning",
        "skill_concrete_example_bridge",
        "skill_concept_mapping",
        "skill_stepwise_scaffolding",
        "skill_misconception_contrast",
        "skill_practice_feedback",
        "skill_transfer_check",
        "skill_learner_summary"
      ]
    },
    "groupId": {
      "type": "object",
      "required": ["learner_id", "session_id", "problem_id", "kc_id"],
      "properties": {
        "learner_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "problem_id": {"$ref": "#/$defs/identifier"},
        "kc_id": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "required": ["domain", "concept", "objective"],
      "properties": {
        "domain": {
          "enum": ["dynamic_programming", "linear_algebra", "python", "probability"]
        },
        "concept": {"type": "string", "minLength": 1, "maxLength": 120},
        "objective": {"type": "string", "minLength": 1, "maxLength": 300}
      },
      "additionalProperties": false
    },
    "currentAction": {
      "type": "object",
      "required": ["skill_id", "action_type", "turn_index", "max_rounds", "prompt"],
      "properties": {
        "skill_id": {"$ref": "#/$defs/primarySkillId"},
        "action_type": {"type": "string", "minLength": 1, "maxLength": 80},
        "turn_index": {"type": "integer", "minimum": 1, "maximum": 50},
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 50},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "group_id",
        "goal",
        "current_action",
        "expected_signal",
        "learner_response",
        "gold_signal",
        "gold_misconception_tag",
        "allowed_primary_skill_ids",
        "should_switch",
        "should_terminate",
        "provenance"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "group_id": {"$ref": "#/$defs/groupId"},
        "goal": {"$ref": "#/$defs/goal"},
        "current_action": {"$ref": "#/$defs/currentAction"},
        "expected_signal": {"type": "string", "minLength": 1, "maxLength": 400},
        "learner_response": {"type": "string", "maxLength": 1000},
        "gold_signal": {"$ref": "#/$defs/signal"},
        "gold_misconception_tag": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "allowed_primary_skill_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/primarySkillId"}
        },
        "should_switch": {"type": "boolean"},
        "should_terminate": {"type": "boolean"},
        "provenance": {"const": "author_constructed_not_expert_validated"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"gold_signal": {"const": "misconception"}},
            "required": ["gold_signal"]
          },
          "then": {
            "properties": {
              "gold_misconception_tag": {"$ref": "#/$defs/identifier"}
            }
          },
          "else": {
            "properties": {
              "gold_misconception_tag": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"gold_signal": {"const": "no_response"}},
            "required": ["gold_signal"]
          },
          "then": {
            "properties": {"learner_response": {"const": ""}}
          },
          "else": {
            "properties": {"learner_response": {"minLength": 1}}
          }
        }
      ],
      "additionalProperties": false
    },
    "claimBoundary": {
      "type": "object",
      "required": [
        "source_type",
        "expert_validated",
        "real_students_involved",
        "free_text_diagnostic_accuracy_established",
        "skill_routing_quality_established",
        "real_learning_effect_established",
        "intended_use",
        "prohibited_claim"
      ],
      "properties": {
        "source_type": {"const": "author_constructed_not_expert_validated"},
        "expert_validated": {"const": false},
        "real_students_involved": {"const": false},
        "free_text_diagnostic_accuracy_established": {"const": false},
        "skill_routing_quality_established": {"const": false},
        "real_learning_effect_established": {"const": false},
        "intended_use": {"type": "string", "minLength": 1},
        "prohibited_claim": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
