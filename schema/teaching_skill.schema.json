{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:teaching-skill:1",
  "title": "Evidence-aware executable Teaching Skill",
  "type": "object",
  "required": [
    "skill_id", "name", "version", "source", "learning_objective", "trigger",
    "preconditions", "goal", "strategies", "procedure", "teacher_actions",
    "student_signals", "success_criteria", "failure_modes", "verification"
  ],
  "properties": {
    "skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "mining_metadata": {"type": "object"},
    "source": {
      "type": "object",
      "required": ["video_id", "course_id", "source_url", "evidence"],
      "properties": {
        "video_id": {"type": "string", "minLength": 1},
        "course_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "transcript_url": {"type": "string", "format": "uri"},
        "transcript_kind": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["evidence_id", "start", "end", "quote", "supports"],
            "properties": {
              "evidence_id": {"type": "string", "pattern": "^evi_[0-9a-f]{16}$"},
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "exclusiveMinimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "supports": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": true
          }
        },
        "modalities_available": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["transcript", "speech", "audio", "visual", "ocr", "classroom_observation"]}
        },
        "multimodal_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_id", "type", "start", "end", "modalities", "supports", "evidence"],
            "properties": {
              "event_id": {"type": "string", "pattern": "^mme_[0-9]{4,}$"},
              "type": {"type": "string", "minLength": 1},
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "minimum": 0},
              "modalities": {"type": "array", "minItems": 1, "uniqueItems": true},
              "supports": {"type": "array", "minItems": 1, "uniqueItems": true},
              "evidence": {"type": "object"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "learning_objective": {
      "type": "object",
      "required": ["statement", "bloom_level", "observable", "assessment"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "bloom_level": {"enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]},
        "observable": {"type": "boolean"},
        "assessment": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "trigger": {"$ref": "#/$defs/nonEmptyStrings"},
    "preconditions": {"$ref": "#/$defs/nonEmptyStrings"},
    "goal": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"},
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "evidence_count", "confidence", "origin"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "evidence_count": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "origin": {"enum": ["observed_method", "recommended_enrichment"]}
        },
        "additionalProperties": true
      }
    },
    "procedure": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "step", "teacher_action", "instruction", "expected_signal", "fallback",
          "origin", "evidence_ids", "provenance"
        ],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "teacher_action": {"$ref": "#/$defs/action"},
          "instruction": {"type": "string", "minLength": 1},
          "expected_signal": {"type": "string", "minLength": 1},
          "fallback": {"type": "string", "minLength": 1},
          "origin": {"enum": ["observed_method", "recommended_enrichment"]},
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(evi_[0-9a-f]{16}|mme_[0-9]{4,})$"}
          },
          "provenance": {
            "type": "object",
            "required": ["origin", "strategy_id", "evidence_ids", "derivation"],
            "properties": {
              "origin": {"enum": ["observed_method", "recommended_enrichment"]},
              "strategy_id": {"type": ["string", "null"]},
              "evidence_ids": {"type": "array", "uniqueItems": true},
              "derivation": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "teacher_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/action"}
    },
    "student_signals": {"$ref": "#/$defs/nonEmptyStrings"},
    "success_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mode", "mitigation"],
        "properties": {
          "mode": {"type": "string", "minLength": 1},
          "mitigation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["type", "prompt", "pass_condition"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "pass_condition": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "action": {
      "enum": [
        "ask", "explain", "demonstrate", "contrast", "prompt",
        "check_understanding", "give_feedback", "summarize", "adapt"
      ]
    }
  },
  "additionalProperties": true
}
