{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:teaching-skill-episode-manifest:1",
  "title": "Candidate episode partition manifest",
  "type": "object",
  "required": ["schema", "artifact_kind", "dataset_manifest_sha256", "video_count", "episode_count", "videos", "claim_boundary"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.episode_partition.v1"},
    "artifact_kind": {"const": "episode_skill_dataset_manifest"},
    "dataset_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "video_count": {"type": "integer", "minimum": 0},
    "episode_count": {"type": "integer", "minimum": 0},
    "videos": {"type": "array"},
    "claim_boundary": {
      "type": "object",
      "required": ["candidate_partition_only", "episode_gold_established", "expert_skill_quality_established", "recognition_accuracy_established", "teaching_effectiveness_established"],
      "properties": {
        "candidate_partition_only": {"const": true},
        "episode_gold_established": {"const": false},
        "expert_skill_quality_established": {"const": false},
        "recognition_accuracy_established": {"const": false},
        "teaching_effectiveness_established": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
