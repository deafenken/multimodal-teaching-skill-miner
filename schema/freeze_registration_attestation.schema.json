{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:freeze-registration-attestation:1",
  "title": "Ed25519 frozen external lockbox attestation",
  "type": "object",
  "required": [
    "schema_version", "protocol", "issuer", "key_id",
    "public_key_sha256", "request", "signature_base64"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol": {"const": "ed25519_frozen_external_lockbox_attestation_v1"},
    "issuer": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"},
    "public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request": {"$ref": "freeze_registration_request.schema.json"},
    "signature_base64": {"type": "string", "minLength": 80}
  },
  "additionalProperties": false
}
