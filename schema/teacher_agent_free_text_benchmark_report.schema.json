{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_free_text_benchmark_report.schema.json",
  "title": "Teacher Agent free-text development benchmark report",
  "type": "object",
  "required": [
    "schema",
    "artifact_kind",
    "run_status",
    "run_fingerprint",
    "input_fingerprints",
    "run_config",
    "online_deepseek",
    "baselines",
    "case_records",
    "privacy",
    "claim_boundary",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "teaching_skill_miner.teacher_agent_free_text_benchmark_report.v1"
    },
    "artifact_kind": {
      "const": "author_constructed_free_text_online_development_benchmark"
    },
    "run_status": {
      "enum": ["baseline_only", "completed", "partial_with_failures"]
    },
    "run_fingerprint": {"$ref": "#/$defs/sha256"},
    "input_fingerprints": {
      "type": "object",
      "required": ["benchmark_sha256", "skill_library_sha256", "protocol_sha256"],
      "properties": {
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "skill_library_sha256": {"$ref": "#/$defs/sha256"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "run_config": {
      "type": "object",
      "required": [
        "prompt_version",
        "online_enabled",
        "repeats",
        "case_order",
        "case_count_per_repeat",
        "minimum_review_confidence",
        "fixed_skill_id",
        "provider_seed_control",
        "temperature",
        "thinking_mode"
      ],
      "properties": {
        "prompt_version": {"const": "teacher_agent_free_text_diagnose_route_v2"},
        "online_enabled": {"type": "boolean"},
        "repeats": {"type": "integer", "minimum": 1, "maximum": 10},
        "case_order": {"const": "dataset_order"},
        "case_count_per_repeat": {"type": "integer", "minimum": 24},
        "minimum_review_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "fixed_skill_id": {"type": "string", "minLength": 1},
        "provider_seed_control": {"type": "string", "minLength": 1},
        "temperature": {"type": ["number", "null"]},
        "thinking_mode": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "online_deepseek": {
      "type": "object",
      "required": ["status", "provider", "model", "metrics", "operational", "repeat_stability"],
      "properties": {
        "status": {
          "enum": ["not_run_baseline_only", "completed", "partial_with_failures"]
        },
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "metrics": {"type": ["object", "null"]},
        "operational": {"type": "object"},
        "repeat_stability": {"type": "object"}
      },
      "additionalProperties": false
    },
    "baselines": {"type": "object", "minProperties": 1},
    "case_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/caseRecord"}
    },
    "privacy": {
      "type": "object",
      "required": [
        "case_input_content_persisted",
        "learner_response_persisted",
        "prompt_content_persisted",
        "provider_response_body_persisted",
        "api_key_persisted_or_logged",
        "per_case_hashes_persisted"
      ],
      "properties": {
        "case_input_content_persisted": {"const": false},
        "learner_response_persisted": {"const": false},
        "prompt_content_persisted": {"const": false},
        "provider_response_body_persisted": {"const": false},
        "api_key_persisted_or_logged": {"const": false},
        "per_case_hashes_persisted": {"const": true}
      },
      "additionalProperties": false
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "source_type",
        "expert_validated",
        "real_students_involved",
        "held_out_after_prompt_development",
        "protocol_reproducible",
        "remote_model_byte_deterministic",
        "free_text_diagnostic_accuracy_established",
        "skill_routing_quality_established",
        "deployment_accuracy_established",
        "real_learning_effect_established",
        "interpretation",
        "baseline_interpretation"
      ],
      "properties": {
        "source_type": {"const": "author_constructed_not_expert_validated"},
        "expert_validated": {"const": false},
        "real_students_involved": {"const": false},
        "held_out_after_prompt_development": {"const": false},
        "protocol_reproducible": {"const": true},
        "remote_model_byte_deterministic": {"const": false},
        "free_text_diagnostic_accuracy_established": {"const": false},
        "skill_routing_quality_established": {"const": false},
        "deployment_accuracy_established": {"const": false},
        "real_learning_effect_established": {"const": false},
        "interpretation": {"type": "string", "minLength": 1},
        "baseline_interpretation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "caseRecord": {
      "type": "object",
      "required": [
        "case_id",
        "repeat_index",
        "case_input_sha256",
        "case_gold_sha256",
        "status",
        "prediction",
        "scoring",
        "needs_human_review",
        "latency_ms",
        "request_sha256",
        "trace",
        "failure"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "repeat_index": {"type": "integer", "minimum": 1, "maximum": 10},
        "case_input_sha256": {"$ref": "#/$defs/sha256"},
        "case_gold_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["completed", "failed"]},
        "prediction": {"type": ["object", "null"]},
        "scoring": {"type": ["object", "null"]},
        "needs_human_review": {"type": "boolean"},
        "latency_ms": {"type": "number", "minimum": 0},
        "request_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "trace": {"type": ["object", "null"]},
        "failure": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
