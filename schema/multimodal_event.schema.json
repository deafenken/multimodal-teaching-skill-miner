{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/multimodal_event.schema.json",
  "title": "Aligned Multimodal Teaching Event",
  "type": "object",
  "required": [
    "event_id", "type", "start", "end", "modalities", "evidence",
    "confidence", "supports_strategies"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^mme_[0-9]{4,}$"},
    "type": {
      "type": "string",
      "enum": [
        "question_and_wait", "scene_change", "slide_change", "board_build_up",
        "code_or_formula_visible", "code_formula_walkthrough", "visual_example",
        "student_confusion", "teacher_adjustment", "student_answer"
      ]
    },
    "start": {"type": "number", "minimum": 0},
    "end": {"type": "number", "minimum": 0},
    "modalities": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["transcript", "speech", "audio", "visual", "ocr", "classroom_observation"]},
      "uniqueItems": true
    },
    "evidence": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "supports_strategies": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
