{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teaching-skill-miner.local/schema/teacher_agent_multimodal_evidence.schema.json",
  "title": "Teacher Agent Multimodal Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_modality",
    "media_sha256",
    "image_sha256",
    "mime_type",
    "provider",
    "provider_spec_sha256",
    "provider_id",
    "processing_region",
    "remote_media_sent",
    "raw_media_retained",
    "task_context_sha256",
    "provider_result_sha256",
    "modality",
    "transcription",
    "semantic_analysis",
    "description",
    "claims",
    "uncertainties",
    "conflicts",
    "decision",
    "semantic_understanding_status",
    "visual_verification_status",
    "provider_confidence_is_answer_correctness",
    "transcription_is_semantic_understanding",
    "semantic_analysis_is_answer_correctness",
    "grading_evidence_allowed",
    "mastery_evidence_allowed",
    "requires_teacher_review",
    "requires_learner_confirmation",
    "abstained",
    "untrusted_instruction_data",
    "privacy_receipt",
    "consent_receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "teaching_skill_miner.multimodal_evidence.v2"
    },
    "source_modality": {
      "enum": ["image", "scanned_pdf_page", "slide", "audio", "video"]
    },
    "media_sha256": {"$ref": "#/$defs/sha256"},
    "image_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "mime_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"},
    "provider": {"$ref": "#/$defs/providerSpec"},
    "provider_spec_sha256": {"$ref": "#/$defs/sha256"},
    "provider_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{2,80}$"},
    "processing_region": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{2,40}$"},
    "remote_media_sent": {"type": "boolean"},
    "raw_media_retained": {"const": false},
    "task_context_sha256": {"$ref": "#/$defs/sha256"},
    "provider_result_sha256": {"$ref": "#/$defs/sha256"},
    "modality": {
      "enum": ["chart", "table", "diagram", "geometry", "formula", "handwriting", "mixed", "unknown"]
    },
    "transcription": {"$ref": "#/$defs/transcription"},
    "semantic_analysis": {"$ref": "#/$defs/semanticAnalysis"},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "claims": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/claim"}
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "conflicts": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/conflict"}
    },
    "decision": {"enum": ["observation", "requires_confirmation", "abstain"]},
    "semantic_understanding_status": {
      "enum": ["provider_observation_requires_review", "not_performed", "conflict", "abstained"]
    },
    "visual_verification_status": {"const": "not_verified"},
    "provider_confidence_is_answer_correctness": {"const": false},
    "transcription_is_semantic_understanding": {"const": false},
    "semantic_analysis_is_answer_correctness": {"const": false},
    "grading_evidence_allowed": {"const": false},
    "mastery_evidence_allowed": {"const": false},
    "requires_teacher_review": {"const": true},
    "requires_learner_confirmation": {"type": "boolean"},
    "abstained": {"type": "boolean"},
    "untrusted_instruction_data": {"const": true},
    "privacy_receipt": {"$ref": "#/$defs/privacyReceipt"},
    "consent_receipt_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "requires_confirmation"}}},
      "then": {
        "properties": {
          "requires_learner_confirmation": {"const": true},
          "abstained": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "abstain"}}},
      "then": {
        "properties": {
          "requires_learner_confirmation": {"const": false},
          "abstained": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "observation"}}},
      "then": {
        "properties": {
          "requires_learner_confirmation": {"const": false},
          "abstained": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"remote_media_sent": {"const": false}}},
      "then": {
        "properties": {
          "consent_receipt_sha256": {"type": "null"},
          "privacy_receipt": {
            "properties": {
              "execution_scope": {"const": "local"},
              "raw_media_sent": {"const": false},
              "provider_retention_days": {"const": 0},
              "consent_id": {"type": "null"},
              "consent_receipt_sha256": {"type": "null"},
              "consent_policy_version": {"type": "null"},
              "data_categories": {"maxItems": 0}
            }
          }
        }
      },
      "else": {
        "properties": {
          "consent_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "privacy_receipt": {
            "properties": {
              "execution_scope": {"const": "remote"},
              "raw_media_sent": {"const": true},
              "consent_id": {"type": "string", "minLength": 1},
              "consent_receipt_sha256": {"$ref": "#/$defs/sha256"},
              "consent_policy_version": {"type": "integer", "minimum": 1},
              "data_categories": {"contains": {"const": "learner_image"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"source_modality": {"const": "image"}}},
      "then": {"properties": {"image_sha256": {"$ref": "#/$defs/sha256"}}},
      "else": {"properties": {"image_sha256": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "providerSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "provider_id", "adapter_version", "execution_scope",
        "processing_region", "raw_media_transport", "provider_retention_days",
        "supported_source_modalities", "supported_mime_types", "capabilities",
        "deterministic", "compatibility_adapter"
      ],
      "properties": {
        "schema": {"const": "teaching_skill_miner.multimodal_provider_spec.v1"},
        "provider_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{2,80}$"},
        "adapter_version": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]{1,80}$"},
        "execution_scope": {"enum": ["local", "remote"]},
        "processing_region": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{2,40}$"},
        "raw_media_transport": {"enum": ["none", "remote"]},
        "provider_retention_days": {
          "oneOf": [{"type": "integer", "minimum": 0, "maximum": 365}, {"type": "null"}]
        },
        "supported_source_modalities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["image", "scanned_pdf_page", "slide", "audio", "video"]}
        },
        "supported_mime_types": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"}
        },
        "capabilities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["transcription", "semantic_analysis", "temporal_transcription"]}
        },
        "deterministic": {"type": "boolean"},
        "compatibility_adapter": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"execution_scope": {"const": "local"}}},
          "then": {
            "properties": {
              "raw_media_transport": {"const": "none"},
              "provider_retention_days": {"const": 0}
            }
          },
          "else": {
            "properties": {"raw_media_transport": {"const": "remote"}}
          }
        },
        {
          "if": {
            "properties": {
              "execution_scope": {"const": "remote"},
              "compatibility_adapter": {"const": false}
            }
          },
          "then": {
            "properties": {
              "provider_retention_days": {
                "type": "integer",
                "minimum": 0,
                "maximum": 365
              }
            }
          }
        }
      ]
    },
    "transcription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "text", "confidence", "confidence_semantics", "language",
        "segments", "student_or_teacher_confirmed", "grading_evidence_allowed",
        "mastery_evidence_allowed"
      ],
      "properties": {
        "status": {"enum": ["not_performed", "unavailable", "candidate", "conflict"]},
        "text": {"type": "string", "maxLength": 24000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_semantics": {"const": "provider_transcription_likelihood_not_semantic_truth_or_correctness"},
        "language": {"type": "string", "pattern": "^[A-Za-z0-9-]{2,35}$"},
        "segments": {
          "type": "array", "maxItems": 512,
          "items": {"$ref": "#/$defs/segment"}
        },
        "student_or_teacher_confirmed": {"const": false},
        "grading_evidence_allowed": {"const": false},
        "mastery_evidence_allowed": {"const": false}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_ms", "end_ms", "text", "evidence_locator", "confidence", "grading_evidence_allowed", "mastery_evidence_allowed"],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^segment_[0-9]{4}$"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_locator": {"type": "string", "minLength": 1, "maxLength": 240},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "grading_evidence_allowed": {"const": false},
        "mastery_evidence_allowed": {"const": false}
      }
    },
    "semanticAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "description", "claims", "uncertainties", "conflicts", "visual_verification_status", "grading_evidence_allowed", "mastery_evidence_allowed"],
      "properties": {
        "status": {"enum": ["not_performed", "provider_observation", "conflict", "abstained"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000},
        "claims": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/claim"}},
        "uncertainties": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "conflicts": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/conflict"}},
        "visual_verification_status": {"const": "unverified_provider_observation"},
        "grading_evidence_allowed": {"const": false},
        "mastery_evidence_allowed": {"const": false}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement", "evidence_locator", "confidence", "confidence_semantics", "verification_status", "untrusted_instruction_data", "grading_evidence_allowed", "mastery_evidence_allowed"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^multimodal_claim_[0-9]{2}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 500},
        "evidence_locator": {"type": "string", "minLength": 1, "maxLength": 240},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_semantics": {"const": "provider_observation_likelihood_not_correctness_or_mastery"},
        "verification_status": {"const": "unverified_provider_observation"},
        "untrusted_instruction_data": {"const": true},
        "grading_evidence_allowed": {"const": false},
        "mastery_evidence_allowed": {"const": false}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_id", "kind", "description", "evidence_locators", "resolution_status"],
      "properties": {
        "conflict_id": {"type": "string", "pattern": "^multimodal_conflict_[0-9]{2}$"},
        "kind": {"enum": ["transcription_disagreement", "slide_notes_disagreement", "cross_layer_disagreement", "ambiguous_visual_relation"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "evidence_locators": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
        "resolution_status": {"const": "unresolved"}
      }
    },
    "privacyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_scope", "raw_media_sent", "processing_region", "provider_retention_days", "consent_id", "consent_receipt_sha256", "consent_policy_version", "data_categories"],
      "properties": {
        "execution_scope": {"enum": ["local", "remote"]},
        "raw_media_sent": {"type": "boolean"},
        "processing_region": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{2,40}$"},
        "provider_retention_days": {"type": "integer", "minimum": 0, "maximum": 365},
        "consent_id": {"type": ["string", "null"]},
        "consent_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "consent_policy_version": {"type": ["integer", "null"]},
        "data_categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
