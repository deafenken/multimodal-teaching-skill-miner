{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_benchmark_v2.schema.json",
  "title": "Teaching Agent product benchmark v2 input artifact",
  "type": "object",
  "required": [
    "schema",
    "benchmark_version",
    "benchmark_id",
    "split",
    "description",
    "goals",
    "student_profiles",
    "cases",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_benchmark_v2.v1"},
    "benchmark_version": {"const": "2.0"},
    "benchmark_id": {"$ref": "#/$defs/id"},
    "split": {"enum": ["development", "held_out_lockbox"]},
    "description": {"type": "string", "minLength": 1, "maxLength": 4000},
    "goals": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/goal"}
    },
    "student_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/studentProfile"}
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/case"}
    },
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,95}$"
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mastery": {
      "type": "object",
      "required": ["prerequisite", "conceptual", "procedural", "transfer"],
      "properties": {
        "prerequisite": {"$ref": "#/$defs/probability"},
        "conceptual": {"$ref": "#/$defs/probability"},
        "procedural": {"$ref": "#/$defs/probability"},
        "transfer": {"$ref": "#/$defs/probability"}
      },
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "required": ["concept", "objective", "success_thresholds", "max_rounds", "materials"],
      "properties": {
        "concept": {"type": "string", "minLength": 1, "maxLength": 240},
        "objective": {"type": "string", "minLength": 1, "maxLength": 1200},
        "knowledge_components": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1}},
        "knowledge_spec": {"type": "object"},
        "success_thresholds": {"$ref": "#/$defs/mastery"},
        "max_rounds": {"type": "integer", "minimum": 2, "maximum": 50},
        "materials": {
          "type": "object",
          "required": ["example", "practice", "transfer_task"],
          "properties": {
            "example": {"type": "string", "minLength": 1},
            "practice": {"type": "string", "minLength": 1},
            "transfer_task": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "studentProfile": {
      "type": "object",
      "required": [
        "profile_ref",
        "learner_level",
        "preferences",
        "accessibility_needs",
        "initial_mastery",
        "known_misconceptions",
        "background_history",
        "conversation_history",
        "contains_direct_identity"
      ],
      "properties": {
        "profile_ref": {"$ref": "#/$defs/id"},
        "learner_level": {"type": "string", "minLength": 1},
        "preferences": {"type": "array", "maxItems": 24, "items": {"type": "string"}},
        "accessibility_needs": {"type": "array", "maxItems": 24, "items": {"type": "string"}},
        "initial_mastery": {"$ref": "#/$defs/mastery"},
        "known_misconceptions": {"type": "array", "maxItems": 24, "items": {"type": "object"}},
        "background_history": {"type": "array", "maxItems": 24, "items": {"type": "string"}},
        "conversation_history": {"type": "array", "maxItems": 24, "items": {"type": "object"}},
        "contains_direct_identity": {"const": false}
      },
      "additionalProperties": false
    },
    "learnerTurn": {
      "type": "object",
      "required": ["turn_id", "learner_input"],
      "properties": {
        "turn_id": {"$ref": "#/$defs/id"},
        "learner_input": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {"type": "string", "maxLength": 4000}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["case_id", "category", "session_group", "goal_ref", "student_profile_ref", "turns"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "category": {"$ref": "#/$defs/id"},
        "session_group": {"$ref": "#/$defs/id"},
        "goal_ref": {"$ref": "#/$defs/id"},
        "student_profile_ref": {"$ref": "#/$defs/id"},
        "turns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": {"$ref": "#/$defs/learnerTurn"}
        }
      },
      "additionalProperties": false
    },
    "claimBoundary": {
      "type": "object",
      "required": [
        "source_type",
        "expert_validated",
        "real_students_involved",
        "held_out_after_prompt_development",
        "deployment_accuracy_established",
        "real_learning_effect_established",
        "intended_use",
        "prohibited_claim"
      ],
      "properties": {
        "source_type": {"enum": ["author_constructed_development", "external_lockbox"]},
        "expert_validated": {"const": false},
        "real_students_involved": {"const": false},
        "held_out_after_prompt_development": {"type": "boolean"},
        "deployment_accuracy_established": {"const": false},
        "real_learning_effect_established": {"const": false},
        "intended_use": {"type": "string", "minLength": 1},
        "prohibited_claim": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
