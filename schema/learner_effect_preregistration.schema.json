{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:learner-effect-preregistration:2",
  "title": "Preregistered external learner-effect cluster RCT package",
  "type": "object",
  "required": ["schema", "preregistration_core", "preregistration_core_sha256", "artifact_bindings", "learner_effectiveness_established"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.learner_effect_preregistration.v2"},
    "preregistration_core": {
      "type": "object",
      "required": ["schema", "protocol_version", "study_id", "design", "governance", "outcomes", "analysis_plan", "semantic_lockbox_binding", "privacy", "claim_boundary", "tokenization"],
      "properties": {
        "schema": {"const": "teaching_skill_miner.learner_effect_preregistration.v2"},
        "protocol_version": {"const": "2.0"},
        "study_id": {"$ref": "#/$defs/id"},
        "design": {
          "type": "object",
          "required": ["study_design", "cluster_unit", "intervention_version", "intervention_build_sha256"],
          "properties": {
            "study_design": {"const": "cluster_randomized_controlled_trial"},
            "cluster_unit": {"enum": ["teacher", "classroom"]},
            "intervention_version": {"type": "string", "minLength": 1},
            "intervention_build_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
          },
          "additionalProperties": true
        },
        "governance": {
          "type": "object",
          "required": ["data_origin", "independent_assessor"],
          "properties": {
            "data_origin": {"enum": ["template", "synthetic", "real"]},
            "independent_assessor": {
              "type": "object",
              "required": ["organization", "key_id", "independent_from_developer_and_intervention_provider_declared", "identity_and_independence_externally_verified"],
              "properties": {
                "organization": {"type": "string", "minLength": 1},
                "key_id": {"type": "string", "minLength": 1},
                "independent_from_developer_and_intervention_provider_declared": {"type": "boolean"},
                "identity_and_independence_externally_verified": {"const": false}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "outcomes": {
          "type": "object",
          "required": ["primary_outcome", "secondary_outcomes", "transfer_assessment_uses_unseen_items", "retention_window_days", "grader_blinding_required", "internal_skill_score_as_outcome_prohibited", "assessor_must_be_independent_and_blind"],
          "properties": {
            "primary_outcome": {"const": "post_score_adjusted_for_pre_score"},
            "secondary_outcomes": {"type": "array", "minItems": 2, "uniqueItems": true},
            "transfer_assessment_uses_unseen_items": {"const": true},
            "retention_window_days": {"const": [14, 28]},
            "grader_blinding_required": {"const": true},
            "internal_skill_score_as_outcome_prohibited": {"const": true},
            "assessor_must_be_independent_and_blind": {"const": true}
          },
          "additionalProperties": true
        },
        "analysis_plan": {
          "type": "object",
          "required": ["estimand", "cluster_bootstrap", "secondary_bootstrap_seeds", "subgroup_analysis", "teacher_burden"],
          "properties": {
            "estimand": {"const": "intention_to_treat_by_randomized_cluster_assignment"},
            "cluster_bootstrap": {"const": "arm_stratified_resample_clusters_with_replacement"},
            "secondary_bootstrap_seeds": {"type": "object"},
            "subgroup_analysis": {
              "type": "object",
              "required": ["predeclared_codes", "definitions_registry_sha256", "minimum_cell_size_per_arm", "small_cells_suppressed", "maximum_allowed_standardized_effect_gap"],
              "properties": {
                "predeclared_codes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"pattern": "^sg[0-9]{2}$"}},
                "definitions_registry_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
                "minimum_cell_size_per_arm": {"type": "integer", "minimum": 5},
                "small_cells_suppressed": {"const": true},
                "maximum_allowed_standardized_effect_gap": {"type": "number", "exclusiveMinimum": 0}
              },
              "additionalProperties": true
            },
            "teacher_burden": {"type": "object"}
          },
          "additionalProperties": true
        },
        "semantic_lockbox_binding": {
          "type": "object",
          "required": ["report_sha256", "required_for_external_claim", "behavioral_lockbox_is_not_learning_effect_evidence"],
          "properties": {
            "report_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
            "required_for_external_claim": {"const": true},
            "behavioral_lockbox_is_not_learning_effect_evidence": {"const": true}
          },
          "additionalProperties": false
        },
        "privacy": {"type": "object"},
        "claim_boundary": {
          "type": "object",
          "required": ["learner_effectiveness_established", "external_validation_status"],
          "properties": {
            "learner_effectiveness_established": {"const": false},
            "external_validation_status": {"const": "external_validation_pending"}
          },
          "additionalProperties": true
        },
        "tokenization": {"type": "object"}
      },
      "additionalProperties": true
    },
    "preregistration_core_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_bindings": {
      "type": "object",
      "required": ["allocation_csv_sha256", "outcome_template_csv_sha256", "teacher_burden_template_csv_sha256"],
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "learner_effectiveness_established": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
