{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:teacher-agent-semantic-lockbox-gold:1",
  "title": "Externally sealed Teaching Agent semantic lockbox gold",
  "type": "object",
  "required": ["schema", "benchmark_version", "benchmark_id", "input_fingerprint", "visibility", "cases"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_semantic_lockbox_gold.v1"},
    "benchmark_version": {"const": "1.0"},
    "benchmark_id": {"$ref": "#/$defs/id"},
    "input_fingerprint": {"$ref": "#/$defs/sha256"},
    "visibility": {"const": "external_custodian_sealed"},
    "cases": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": ["case_id", "expert_label", "mastery_gain_allowed", "phase_advance_allowed", "abstention_required", "expert_review"],
        "properties": {
          "case_id": {"$ref": "#/$defs/id"},
          "expert_label": {"enum": ["correct", "partial", "misconception", "confused", "no_response"]},
          "mastery_gain_allowed": {"type": "boolean"},
          "phase_advance_allowed": {"type": "boolean"},
          "abstention_required": {"type": "boolean"},
          "expert_review": {
            "type": "object",
            "required": ["independent_reviewer_count", "adjudicated", "agreement", "review_receipt_sha256"],
            "properties": {
              "independent_reviewer_count": {"type": "integer", "minimum": 2},
              "adjudicated": {"const": true},
              "agreement": {"enum": ["agreed", "resolved_by_third_reviewer"]},
              "review_receipt_sha256": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
