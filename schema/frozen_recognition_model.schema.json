{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:frozen-recognition-model:3",
  "title": "Integrity-bound frozen classroom-recognition model",
  "type": "object",
  "required": [
    "schema_version",
    "protocol",
    "modality",
    "component_modalities",
    "feature_names_by_modality",
    "feature_provenance_by_modality",
    "class_names",
    "selected_C",
    "required_identity_fields",
    "claim_cluster_field",
    "training_identity_values_by_field",
    "claim_contract",
    "claim_contract_fingerprint",
    "training_dataset_fingerprint",
    "training_feature_bundle_fingerprint",
    "training_feature_bundle_algorithm",
    "training_sample_ids",
    "training_content_hashes",
    "selection_report",
    "scaler_mean",
    "scaler_scale",
    "coefficient",
    "intercept",
    "model_classes",
    "model_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "protocol": {"const": "frozen_deployment_model_v3_feature_and_claim_contract"},
    "modality": {"type": "string", "minLength": 1},
    "component_modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "feature_names_by_modality": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "feature_provenance_by_modality": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "object",
        "required": [
          "extractor_id",
          "extractor_fingerprint",
          "frozen_before_evaluation",
          "uses_ground_truth_labels",
          "fitted_on_evaluation_records"
        ],
        "properties": {
          "extractor_id": {"type": "string", "minLength": 1},
          "extractor_fingerprint": {"$ref": "#/$defs/sha256"},
          "frozen_before_evaluation": {"const": true},
          "uses_ground_truth_labels": {"const": false},
          "fitted_on_evaluation_records": {"const": false}
        },
        "additionalProperties": true
      }
    },
    "class_names": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "selected_C": {"type": "number", "exclusiveMinimum": 0},
    "required_identity_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identity_field"},
      "contains": {"const": "session_id"}
    },
    "claim_cluster_field": {"$ref": "#/$defs/identity_field"},
    "training_identity_values_by_field": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identity_field"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "claim_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "primary_metric",
        "minimum_primary_metric",
        "minimum_accuracy",
        "minimum_macro_f1",
        "minimum_accuracy_ci_lower",
        "minimum_macro_f1_ci_lower",
        "minimum_per_class_recall",
        "minimum_per_class_support",
        "minimum_sessions",
        "minimum_coverage_fraction",
        "require_prospective",
        "require_one_time_lockbox"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "primary_metric": {"enum": ["accuracy", "macro_f1"]},
        "minimum_primary_metric": {"$ref": "#/$defs/unit_interval"},
        "minimum_accuracy": {"$ref": "#/$defs/unit_interval"},
        "minimum_macro_f1": {"$ref": "#/$defs/unit_interval"},
        "minimum_accuracy_ci_lower": {"$ref": "#/$defs/unit_interval"},
        "minimum_macro_f1_ci_lower": {"$ref": "#/$defs/unit_interval"},
        "minimum_per_class_recall": {"$ref": "#/$defs/unit_interval"},
        "minimum_per_class_support": {"type": "integer", "minimum": 1},
        "minimum_sessions": {"type": "integer", "minimum": 2},
        "minimum_coverage_fraction": {"$ref": "#/$defs/unit_interval"},
        "require_prospective": {"type": "boolean"},
        "require_one_time_lockbox": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "claim_contract_fingerprint": {"$ref": "#/$defs/sha256"},
    "training_dataset_fingerprint": {"$ref": "#/$defs/sha256"},
    "training_feature_bundle_fingerprint": {"$ref": "#/$defs/sha256"},
    "training_feature_bundle_algorithm": {"const": "strict_feature_bundle_v1"},
    "training_sample_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "training_content_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "selection_report": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "scaler_mean": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "scaler_scale": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "coefficient": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "number"}
      }
    },
    "intercept": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "model_classes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "model_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unit_interval": {"type": "number", "minimum": 0, "maximum": 1},
    "identity_field": {
      "enum": [
        "session_id",
        "participant_id",
        "teacher_id",
        "cohort_id",
        "activity_id",
        "site_id"
      ]
    }
  },
  "additionalProperties": false
}
