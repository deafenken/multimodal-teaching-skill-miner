{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:raw-feature-extractor-config:1",
  "title": "Frozen raw media and sensor feature extractor configuration",
  "type": "object",
  "required": ["schema_version", "extractor_suite_id", "modalities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "extractor_suite_id": {"type": "string", "minLength": 1},
    "modalities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/visual"},
          {"$ref": "#/$defs/audio"},
          {"$ref": "#/$defs/sensor"}
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "visual": {
      "type": "object",
      "required": ["kind", "input_key"],
      "properties": {
        "kind": {"const": "builtin_classroom_video_visual_v1"},
        "input_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
        "frame_count": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 16},
        "height": {"type": "integer", "minimum": 9},
        "clip_seconds": {"type": "number", "minimum": 0.2}
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "required": ["kind", "input_key"],
      "properties": {
        "kind": {"const": "builtin_classroom_video_audio_v1"},
        "input_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
        "sample_rate": {"type": "integer", "minimum": 8000},
        "clip_seconds": {"type": "number", "minimum": 0.2}
      },
      "additionalProperties": false
    },
    "sensor": {
      "type": "object",
      "required": ["kind", "input_key", "value_fields"],
      "properties": {
        "kind": {"const": "builtin_numeric_sensor_summary_v1"},
        "input_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
        "value_fields": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"}
        },
        "timestamp_field": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "minimum_rows": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
