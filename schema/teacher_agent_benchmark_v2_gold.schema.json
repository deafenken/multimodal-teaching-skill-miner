{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_benchmark_v2_gold.schema.json",
  "title": "Teaching Agent product benchmark v2 separately governed gold",
  "type": "object",
  "required": [
    "schema",
    "benchmark_version",
    "benchmark_id",
    "split",
    "gold_visibility",
    "input_fingerprint",
    "cases",
    "session_groups",
    "outcome_observations",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_benchmark_v2_gold.v1"},
    "benchmark_version": {"const": "2.0"},
    "benchmark_id": {"$ref": "#/$defs/id"},
    "split": {"enum": ["development", "held_out_lockbox"]},
    "gold_visibility": {"enum": ["separate_development_file", "external_sealed"]},
    "input_fingerprint": {"$ref": "#/$defs/sha256"},
    "cases": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/caseGold"}},
    "session_groups": {"type": "array", "items": {"$ref": "#/$defs/sessionGroup"}},
    "outcome_observations": {"type": "array", "items": {"$ref": "#/$defs/outcome"}},
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "termGroups": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1}}
    },
    "turnGold": {
      "type": "object",
      "required": ["turn_id", "allowed_primary_skill_ids", "expected_switch", "recall_term_groups", "expected_memory_status", "expected_active_misconception_tags", "expected_resolved_misconception_tags", "required_resolution_evidence", "forbidden_output_terms", "direct_answer_terms", "prompt_injection_blocked", "should_stop"],
      "properties": {
        "turn_id": {"$ref": "#/$defs/id"},
        "allowed_primary_skill_ids": {"type": "array", "minItems": 1, "maxItems": 13, "items": {"$ref": "#/$defs/id"}},
        "expected_switch": {"type": ["boolean", "null"]},
        "recall_term_groups": {"$ref": "#/$defs/termGroups"},
        "expected_memory_status": {"enum": ["not_requested", "resolved_evidence_linked", "unresolved_no_matching_evidence"]},
        "expected_active_misconception_tags": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/id"}},
        "expected_resolved_misconception_tags": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/id"}},
        "required_resolution_evidence": {"type": "boolean"},
        "forbidden_output_terms": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
        "direct_answer_terms": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
        "prompt_injection_blocked": {"type": "boolean"},
        "should_stop": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "caseGold": {
      "type": "object",
      "required": ["case_id", "turns"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "turns": {"type": "array", "minItems": 2, "maxItems": 24, "items": {"$ref": "#/$defs/turnGold"}}
      },
      "additionalProperties": false
    },
    "sessionGroup": {
      "type": "object",
      "required": ["group_id", "case_ids", "forbidden_terms_by_case"],
      "properties": {
        "group_id": {"$ref": "#/$defs/id"},
        "case_ids": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/id"}},
        "forbidden_terms_by_case": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}}
      },
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "required": ["earned", "possible"],
      "properties": {"earned": {"type": "number", "minimum": 0}, "possible": {"type": "number", "exclusiveMinimum": 0}},
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["schema", "case_id", "provenance", "pretest", "posttest", "transfer_test", "delayed_test"],
      "properties": {
        "schema": {"const": "teaching_skill_miner.teacher_agent_learning_observation.v1"},
        "case_id": {"$ref": "#/$defs/id"},
        "provenance": {"enum": ["author_constructed_demo_not_real", "teacher_provided_test_record", "authorized_real_learner_observation"]},
        "pretest": {"$ref": "#/$defs/score"},
        "posttest": {"$ref": "#/$defs/score"},
        "transfer_test": {"oneOf": [{"$ref": "#/$defs/score"}, {"type": "null"}]},
        "delayed_test": {"oneOf": [{"$ref": "#/$defs/score"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "claimBoundary": {
      "type": "object",
      "required": ["source_type", "expert_validated", "real_students_involved", "held_out_after_prompt_development", "deployment_accuracy_established", "real_learning_effect_established", "intended_use", "prohibited_claim"],
      "properties": {
        "source_type": {"enum": ["author_constructed_development", "external_lockbox"]},
        "expert_validated": {"const": false},
        "real_students_involved": {"const": false},
        "held_out_after_prompt_development": {"type": "boolean"},
        "deployment_accuracy_established": {"const": false},
        "real_learning_effect_established": {"const": false},
        "intended_use": {"type": "string", "minLength": 1},
        "prohibited_claim": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
