{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:external-evaluation-receipt:1",
  "title": "Ed25519 completed external evaluation receipt",
  "type": "object",
  "required": [
    "schema_version", "protocol", "issuer", "key_id",
    "public_key_sha256", "payload", "signature_base64"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol": {"const": "ed25519_external_evaluation_report_receipt_v1"},
    "issuer": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"},
    "public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "required": [
        "schema_version", "protocol", "registration_id",
        "registration_attestation_fingerprint", "evaluation_report_fingerprint",
        "deployment_accuracy_established", "signed_at_utc"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "protocol": {"const": "external_evaluation_report_receipt_v1"},
        "registration_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"},
        "registration_attestation_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evaluation_report_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deployment_accuracy_established": {"type": "boolean"},
        "signed_at_utc": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "signature_base64": {"type": "string", "minLength": 80}
  },
  "additionalProperties": false
}
