{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:strict-recognition-manifest:2",
  "title": "Strict classroom-recognition evaluation manifest",
  "type": "object",
  "required": ["schema_version", "audit", "records"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "audit": {
      "type": "object",
      "required": [
        "dataset_id",
        "dataset_fingerprint",
        "provenance_verified",
        "real_classroom_recording",
        "independent_human_ground_truth",
        "synchronized_modalities_verified",
        "identity_metadata_verified",
        "identity_metadata_source",
        "ground_truth_source"
      ],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "dataset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance_verified": {"const": true},
        "real_classroom_recording": {"const": true},
        "independent_human_ground_truth": {"const": true},
        "synchronized_modalities_verified": {"const": true},
        "identity_metadata_source": {"type": "string", "minLength": 1},
        "ground_truth_source": {"type": "string", "minLength": 1},
        "identity_metadata_verified": {
          "type": "object",
          "required": ["session_id", "site_id"],
          "properties": {
            "session_id": {"const": true},
            "participant_id": {"type": "boolean"},
            "teacher_id": {"type": "boolean"},
            "cohort_id": {"type": "boolean"},
            "activity_id": {"type": "boolean"},
            "site_id": {"const": true}
          },
          "additionalProperties": false
        },
        "held_out_from_model_development": {"type": "boolean"},
        "deployment_target_documented": {"type": "boolean"},
        "prospective_deployment_collection": {"type": "boolean"},
        "one_time_lockbox_evaluation": {"type": "boolean"},
        "evaluation_coverage_fraction": {"type": "number", "minimum": 0, "maximum": 1}
        ,
        "evaluation_coverage": {
          "type": "object",
          "required": [
            "eligible_sample_count", "evaluated_sample_count", "excluded_sample_count",
            "eligible_population_fingerprint", "denominator_source",
            "exclusion_reason_counts", "coverage_evidence_fingerprint"
          ],
          "properties": {
            "eligible_sample_count": {"type": "integer", "minimum": 1},
            "evaluated_sample_count": {"type": "integer", "minimum": 1},
            "excluded_sample_count": {"type": "integer", "minimum": 0},
            "eligible_population_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "denominator_source": {"type": "string", "minLength": 1},
            "exclusion_reason_counts": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "coverage_evidence_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sample_id",
          "content_sha256",
          "label",
          "session_id",
          "site_id",
          "modalities"
        ],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "label": {"type": "integer", "minimum": 0},
          "label_name": {"type": "string"},
          "session_id": {"type": "string", "minLength": 1},
          "participant_id": {"type": "string", "minLength": 1},
          "teacher_id": {"type": "string", "minLength": 1},
          "cohort_id": {"type": "string", "minLength": 1},
          "activity_id": {"type": "string", "minLength": 1},
          "site_id": {"type": "string", "minLength": 1},
          "modalities": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "boolean"}
          },
          "raw_inputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "start_offset_seconds": {"type": "number", "minimum": 0},
                "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
