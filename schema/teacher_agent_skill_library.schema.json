{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_skill_library.schema.json",
  "title": "Task-two Teaching Agent Skill Library",
  "type": "object",
  "required": ["schema", "library_id", "name", "version", "derivation", "skills", "claim_boundary"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_skill_library.v1"},
    "library_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "derivation": {
      "type": "object",
      "required": ["general_skill_id", "source_artifact", "method", "claim_boundary"],
      "properties": {
        "general_skill_id": {"const": "evidence_grounded_adaptive_concept_teaching_v0"},
        "source_artifact": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "claim_boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/skill"}
    },
    "claim_boundary": {
      "type": "object",
      "required": ["classroom_video_observed_skills", "operationalized_from_existing_general_skill", "real_time_policy_implemented", "free_text_grader_included", "real_learner_effectiveness_established"],
      "properties": {
        "classroom_video_observed_skills": {"const": false},
        "operationalized_from_existing_general_skill": {"const": true},
        "real_time_policy_implemented": {"const": true},
        "free_text_grader_included": {"const": false},
        "real_learner_effectiveness_established": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["skill_id", "name", "role", "focus_dimension", "base_priority", "applicable_signals", "supporting_skill_ids", "selection_rationale", "message_template", "expected_signal", "action_type", "direct_answer_prohibited", "source"],
      "properties": {
        "skill_id": {"type": "string", "pattern": "^skill_[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "role": {"enum": ["diagnostic", "example", "concept_mapping", "scaffolding", "correction", "practice", "transfer", "summary", "support"]},
        "focus_dimension": {"enum": ["prerequisite", "conceptual", "procedural", "transfer"]},
        "base_priority": {"type": "number"},
        "applicable_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["not_observed", "correct", "partial", "misconception", "confused", "no_response"]}
        },
        "supporting_skill_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "selection_rationale": {"type": "string", "minLength": 1},
        "message_template": {"type": "string", "minLength": 1},
        "expected_signal": {"type": "string", "minLength": 1},
        "action_type": {"type": "string", "minLength": 1},
        "direct_answer_prohibited": {"type": "boolean"},
        "source": {
          "type": "object",
          "required": ["origin", "general_skill_id", "source_phase_ids", "source_strategy_ids", "observed_status"],
          "properties": {
            "origin": {"const": "operational_wrapper_from_general_skill_v0"},
            "general_skill_id": {"const": "evidence_grounded_adaptive_concept_teaching_v0"},
            "source_phase_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "source_strategy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "observed_status": {"enum": ["cross_lecture_observed_consensus", "recommended_enrichment", "mixed_observed_and_recommended"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
