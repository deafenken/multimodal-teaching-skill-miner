{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-harness/agent_harness_event.schema.json",
  "title": "Agent Harness authoritative event envelope",
  "type": "object",
  "required": ["schema", "event_id", "run_id", "turn_id", "sequence", "type", "timestamp", "payload"],
  "properties": {
    "schema": {"const": "agent_harness.event.v1"},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "sequence": {"type": "integer", "minimum": 1},
    "type": {
      "enum": [
        "run.started",
        "run.completed",
        "run.cancelled",
        "run.failed",
        "run.handoff",
        "model.started",
        "model.completed",
        "model.failed",
        "model.retrying",
        "model.retry_suppressed",
        "message.start",
        "message.delta",
        "message.end",
        "reasoning.delta",
        "usage.update",
        "tool_call.delta",
        "tool.requested",
        "tool.started",
        "tool.effect_started",
        "tool.progress",
        "tool.retrying",
        "tool.completed",
        "tool.failed",
        "tool.rejected",
        "tool.replayed",
        "tool.reconciled",
        "input.steered",
        "guard.triggered",
        "action.started",
        "action.completed",
        "action.superseded",
        "progress.updated",
        "operation.result",
        "state.committed"
      ]
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "causation_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
