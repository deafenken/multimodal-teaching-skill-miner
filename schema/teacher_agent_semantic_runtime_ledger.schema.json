{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:teacher-agent-semantic-runtime-ledger:1",
  "title": "Content-free semantic lockbox runtime ledger",
  "type": "object",
  "required": ["schema", "benchmark_version", "benchmark_id", "input_fingerprint", "derivation", "raw_learner_text_included", "raw_teacher_text_included", "cases", "content_sha256"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_semantic_runtime_ledger.v1"},
    "benchmark_version": {"const": "1.0"},
    "benchmark_id": {"$ref": "#/$defs/id"},
    "input_fingerprint": {"$ref": "#/$defs/sha256"},
    "derivation": {"const": "integrity_checked_teacher_agent_session_history_v1"},
    "raw_learner_text_included": {"const": false},
    "raw_teacher_text_included": {"const": false},
    "cases": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": ["case_id", "domain", "learner_text_sha256", "session_content_sha256", "event_round", "observed_signal", "observed_confidence", "needs_human_review", "semantic_authority_established", "assessment_eligible", "applied_to_mastery", "mastery_delta", "phase_advanced", "event_fingerprint"],
        "properties": {
          "case_id": {"$ref": "#/$defs/id"},
          "domain": {"$ref": "#/$defs/id"},
          "learner_text_sha256": {"$ref": "#/$defs/sha256"},
          "session_content_sha256": {"$ref": "#/$defs/sha256"},
          "event_round": {"type": "integer", "minimum": 1},
          "observed_signal": {"enum": ["correct", "partial", "misconception", "confused", "no_response"]},
          "observed_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "needs_human_review": {"type": "boolean"},
          "semantic_authority_established": {"type": "boolean"},
          "assessment_eligible": {"type": "boolean"},
          "applied_to_mastery": {"type": "boolean"},
          "mastery_delta": {"type": "number"},
          "phase_advanced": {"type": "boolean"},
          "event_fingerprint": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
