{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_metacognition_export.schema.json",
  "title": "Teaching Agent learner metacognition private export",
  "type": "object",
  "required": ["schema", "learner_key", "events", "calibration_records", "external_calibration_established", "validity_note"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.metacognition_export.v1"},
    "learner_key": {"type": "string", "pattern": "^learner_[0-9a-f]{64}$"},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "teacher_agent_metacognition_event.schema.json"}},
    "calibration_records": {"type": "array", "items": {"$ref": "teacher_agent_metacognition_record.schema.json"}},
    "external_calibration_established": {"const": false},
    "validity_note": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
