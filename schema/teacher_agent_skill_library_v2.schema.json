{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_skill_library_v2.schema.json",
  "title": "Task-two neural-v1 runtime Teaching Skill Library",
  "type": "object",
  "required": ["schema", "library_id", "name", "version", "derivation", "skills", "claim_boundary"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_skill_library.v2"},
    "library_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^2\\."},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "derivation": {
      "type": "object",
      "required": ["general_skill_id", "source_artifact", "source_status", "method", "claim_boundary"],
      "properties": {
        "general_skill_id": {"const": "evidence_grounded_multimodal_teaching_neural_v1"},
        "source_artifact": {"const": "data/neural_v1_runtime_manifest.json"},
        "source_status": {"const": "model_assisted_neural_v1_provisional_failed_evidence_gate"},
        "method": {"type": "string", "minLength": 1},
        "claim_boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/skill"}
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "classroom_video_observed_skills",
        "runtime_ontology_from_neural_v1",
        "neural_v1_materialization_gate_passed",
        "research_supplements_separately_marked",
        "real_time_policy_implemented",
        "free_text_grader_included",
        "free_text_grading_accuracy_established",
        "real_learner_effectiveness_established"
      ],
      "properties": {
        "classroom_video_observed_skills": {"const": false},
        "runtime_ontology_from_neural_v1": {"const": true},
        "neural_v1_materialization_gate_passed": {"const": false},
        "research_supplements_separately_marked": {"const": true},
        "real_time_policy_implemented": {"const": true},
        "free_text_grader_included": {"const": true},
        "free_text_grading_accuracy_established": {"const": false},
        "real_learner_effectiveness_established": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "skill": {
      "type": "object",
      "required": [
        "skill_id", "name", "role", "focus_dimension", "base_priority",
        "applicable_signals", "supporting_skill_ids", "selection_rationale",
        "message_template", "expected_signal", "action_type",
        "direct_answer_prohibited", "execution_contract", "source"
      ],
      "properties": {
        "skill_id": {"type": "string", "pattern": "^skill_[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "role": {"enum": ["diagnostic", "context", "example", "concept_mapping", "scaffolding", "assessment", "correction", "practice", "review", "metacognition", "engagement", "transfer", "summary", "support"]},
        "focus_dimension": {"enum": ["prerequisite", "conceptual", "procedural", "transfer"]},
        "base_priority": {"type": "number"},
        "applicable_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["not_observed", "correct", "partial", "misconception", "confused", "no_response"]}
        },
        "supporting_skill_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^skill_[a-z0-9_]+$"}},
        "selection_rationale": {"type": "string", "minLength": 1},
        "message_template": {"type": "string", "minLength": 1},
        "expected_signal": {"type": "string", "minLength": 1},
        "action_type": {"type": "string", "minLength": 1},
        "direct_answer_prohibited": {"const": true},
        "execution_contract": {
          "type": "object",
          "required": ["applicable_when", "contraindications", "preconditions", "postconditions", "failure_transition", "max_repeat", "addition_reason"],
          "properties": {
            "applicable_when": {"type": "string", "minLength": 1},
            "contraindications": {"$ref": "#/$defs/stringList"},
            "preconditions": {"$ref": "#/$defs/nonemptyStrings"},
            "postconditions": {"$ref": "#/$defs/nonemptyStrings"},
            "failure_transition": {
              "anyOf": [
                {"type": "string", "pattern": "^skill_[a-z0-9_]+$"},
                {"const": "terminate_or_escalate"}
              ]
            },
            "max_repeat": {"type": "integer", "minimum": 1, "maximum": 50},
            "addition_reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "required": ["origin", "general_skill_id", "source_phase_ids", "source_strategy_ids", "observed_status"],
          "properties": {
            "origin": {"enum": ["operational_wrapper_from_neural_v1_provisional_ontology", "neural_v1_strategy_plus_peer_reviewed_research_supplement", "research_supplement_to_neural_v1_runtime", "peer_reviewed_research_supplement"]},
            "general_skill_id": {"const": "evidence_grounded_multimodal_teaching_neural_v1"},
            "source_phase_ids": {"$ref": "#/$defs/nonemptyStrings"},
            "source_strategy_ids": {"$ref": "#/$defs/nonemptyStrings"},
            "observed_status": {"enum": ["provisional_normative_not_observed_consensus", "research_supplement_not_video_consensus"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
