{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teachlab.local/schema/teachlab_embedded_runtime.schema.json",
  "title": "TeachLab audited embedded runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime_id",
    "kind",
    "version",
    "platform",
    "architectures",
    "executable",
    "tree_sha256",
    "self_contained",
    "license_files",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "teachlab.embedded-runtime.v1"},
    "runtime_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$"},
    "kind": {"enum": ["node", "python"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "platform": {"const": "darwin"},
    "architectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["arm64", "x64"]}
    },
    "executable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/+ -]+$"
    },
    "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "self_contained": {"const": true},
    "license_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/+ -]+$"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_uri", "source_sha256", "builder"],
      "properties": {
        "source_uri": {"type": "string", "pattern": "^https://", "maxLength": 2048},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "builder": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    }
  }
}
