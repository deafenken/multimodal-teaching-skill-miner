{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:teacher-agent-semantic-lockbox-attestation:1",
  "title": "Independent semantic lockbox attestation",
  "type": "object",
  "required": ["protocol", "issuer", "key_id", "public_key_sha256", "payload", "signature_base64"],
  "properties": {
    "protocol": {"enum": ["ed25519_teacher_agent_semantic_lockbox_gold_v1", "ed25519_teacher_agent_semantic_runtime_ledger_v1"]},
    "issuer": {"$ref": "#/$defs/id"},
    "key_id": {"$ref": "#/$defs/id"},
    "public_key_sha256": {"$ref": "#/$defs/sha256"},
    "payload": {"type": "object"},
    "signature_base64": {"type": "string", "minLength": 80, "maxLength": 128}
  },
  "allOf": [
    {
      "if": {"properties": {"protocol": {"const": "ed25519_teacher_agent_semantic_lockbox_gold_v1"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/goldPayload"}}},
      "else": {"properties": {"payload": {"$ref": "#/$defs/runtimePayload"}}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "goldPayload": {
      "type": "object",
      "required": ["protocol", "registration_id", "benchmark_id", "input_fingerprint", "gold_fingerprint", "signed_at_utc", "maximum_evaluations", "labels_unavailable_during_system_development"],
      "properties": {
        "protocol": {"const": "ed25519_teacher_agent_semantic_lockbox_gold_v1"},
        "registration_id": {"$ref": "#/$defs/id"},
        "benchmark_id": {"$ref": "#/$defs/id"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "gold_fingerprint": {"$ref": "#/$defs/sha256"},
        "signed_at_utc": {"type": "string", "format": "date-time"},
        "maximum_evaluations": {"const": 1},
        "labels_unavailable_during_system_development": {"const": true}
      },
      "additionalProperties": false
    },
    "runtimePayload": {
      "type": "object",
      "required": ["protocol", "benchmark_id", "input_fingerprint", "runtime_ledger_fingerprint", "runtime_derivation", "gold_available_to_runtime", "signed_at_utc"],
      "properties": {
        "protocol": {"const": "ed25519_teacher_agent_semantic_runtime_ledger_v1"},
        "benchmark_id": {"$ref": "#/$defs/id"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "runtime_ledger_fingerprint": {"$ref": "#/$defs/sha256"},
        "runtime_derivation": {"const": "integrity_checked_teacher_agent_session_history_v1"},
        "gold_available_to_runtime": {"const": false},
        "signed_at_utc": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
