{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_safeguarding_store.schema.json",
  "title": "Durable content-minimized safeguarding case store",
  "type": "object",
  "required": [
    "schema",
    "version",
    "event_sequence",
    "events",
    "erasure_tombstones",
    "erasure_fence",
    "retention_compaction"
  ],
  "properties": {
    "schema": {"const": "teaching_skill_miner.safeguarding_store.v2"},
    "version": {"const": 2},
    "event_sequence": {"type": "integer", "minimum": 0, "maximum": 32768},
    "events": {
      "type": "array",
      "maxItems": 32768,
      "items": {"$ref": "#/$defs/event"}
    },
    "erasure_tombstones": {
      "type": "object",
      "maxProperties": 1024,
      "propertyNames": {"$ref": "#/$defs/digest"},
      "additionalProperties": {"$ref": "#/$defs/tombstone"}
    },
    "erasure_fence": {"$ref": "#/$defs/erasure_fence"},
    "retention_compaction": {"$ref": "#/$defs/retention_compaction"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8}){0,3}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "actor": {
      "type": "object",
      "required": [
        "schema",
        "actor_kind",
        "principal_sha256",
        "role_sha256",
        "authorization_context_sha256",
        "operation",
        "body_sha256",
        "authorization_receipt_sha256",
        "verified_at_utc"
      ],
      "properties": {
        "schema": {
          "const": "teaching_skill_miner.safeguarding_actor_receipt.v1"
        },
        "actor_kind": {
          "enum": [
            "system_safety_classifier",
            "server_authenticated_safeguarding"
          ]
        },
        "principal_sha256": {"$ref": "#/$defs/digest"},
        "role_sha256": {"$ref": "#/$defs/digest"},
        "authorization_context_sha256": {"$ref": "#/$defs/digest"},
        "operation": {
          "enum": [
            "case.opened",
            "case.acknowledged",
            "case.closed",
            "escalation.overdue",
            "escalation.acknowledged",
            "case.purged"
          ]
        },
        "body_sha256": {"$ref": "#/$defs/digest"},
        "authorization_receipt_sha256": {"$ref": "#/$defs/digest"},
        "verified_at_utc": {"$ref": "#/$defs/utc"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"actor_kind": {"const": "system_safety_classifier"}},
            "required": ["actor_kind"]
          },
          "then": {
            "properties": {
              "role_sha256": {
                "const": "272590d3f3d84caa9b63e9d5318419bad534244ec7c29bf2b932d82c732f90fa"
              },
              "operation": {"const": "case.opened"}
            }
          },
          "else": {
            "properties": {
              "role_sha256": {
                "const": "ff0a6cdd9508192f8c2203172c5dfa6056406d95dbe007dff47f0fe5122fcd3c"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "resource_receipt": {
      "type": "object",
      "required": [
        "policy_version",
        "locale_selection_source",
        "configured_locale_sha256",
        "effective_locale",
        "localization_status",
        "localization_unavailable",
        "resource_set_sha256"
      ],
      "properties": {
        "policy_version": {"$ref": "#/$defs/token"},
        "locale_selection_source": {
          "const": "trusted_deployment_scope_mapping"
        },
        "configured_locale_sha256": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "effective_locale": {
          "anyOf": [
            {"$ref": "#/$defs/locale"},
            {"const": "generic"}
          ]
        },
        "localization_status": {
          "enum": ["localized", "localization_unavailable"]
        },
        "localization_unavailable": {"type": "boolean"},
        "resource_set_sha256": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"localization_unavailable": {"const": true}},
            "required": ["localization_unavailable"]
          },
          "then": {
            "properties": {
              "effective_locale": {"const": "generic"},
              "localization_status": {"const": "localization_unavailable"}
            }
          },
          "else": {
            "properties": {
              "effective_locale": {
                "allOf": [
                  {"$ref": "#/$defs/locale"},
                  {"not": {"const": "generic"}}
                ]
              },
              "localization_status": {"const": "localized"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "unavailable_escalation": {
      "type": "object",
      "required": [
        "delivery_status",
        "reason_code",
        "policy_version",
        "queue_sha256",
        "delivery_id",
        "sla_seconds",
        "enqueued_at_utc",
        "sla_due_at_utc",
        "overdue_recorded_at_utc",
        "acknowledged_at_utc",
        "acknowledged_by"
      ],
      "properties": {
        "delivery_status": {"const": "escalation_unavailable"},
        "reason_code": {"const": "delivery_not_configured"},
        "policy_version": {"type": "null"},
        "queue_sha256": {"type": "null"},
        "delivery_id": {"type": "null"},
        "sla_seconds": {"type": "null"},
        "enqueued_at_utc": {"type": "null"},
        "sla_due_at_utc": {"type": "null"},
        "overdue_recorded_at_utc": {"type": "null"},
        "acknowledged_at_utc": {"type": "null"},
        "acknowledged_by": {"type": "null"}
      },
      "additionalProperties": false
    },
    "configured_escalation": {
      "type": "object",
      "required": [
        "delivery_status",
        "reason_code",
        "policy_version",
        "queue_sha256",
        "delivery_id",
        "sla_seconds",
        "enqueued_at_utc",
        "sla_due_at_utc",
        "overdue_recorded_at_utc",
        "acknowledged_at_utc",
        "acknowledged_by"
      ],
      "properties": {
        "delivery_status": {"enum": ["pending", "overdue", "acknowledged"]},
        "reason_code": {"type": "null"},
        "policy_version": {"$ref": "#/$defs/token"},
        "queue_sha256": {"$ref": "#/$defs/digest"},
        "delivery_id": {"type": "string", "pattern": "^sge_[0-9a-f]{24}$"},
        "sla_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 604800
        },
        "enqueued_at_utc": {"$ref": "#/$defs/utc"},
        "sla_due_at_utc": {"$ref": "#/$defs/utc"},
        "overdue_recorded_at_utc": {
          "oneOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]
        },
        "acknowledged_at_utc": {
          "oneOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]
        },
        "acknowledged_by": {
          "oneOf": [{"$ref": "#/$defs/actor"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"delivery_status": {"const": "pending"}},
            "required": ["delivery_status"]
          },
          "then": {
            "properties": {
              "overdue_recorded_at_utc": {"type": "null"},
              "acknowledged_at_utc": {"type": "null"},
              "acknowledged_by": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"delivery_status": {"const": "overdue"}},
            "required": ["delivery_status"]
          },
          "then": {
            "properties": {
              "overdue_recorded_at_utc": {"$ref": "#/$defs/utc"},
              "acknowledged_at_utc": {"type": "null"},
              "acknowledged_by": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"delivery_status": {"const": "acknowledged"}},
            "required": ["delivery_status"]
          },
          "then": {
            "properties": {
              "acknowledged_at_utc": {"$ref": "#/$defs/utc"},
              "acknowledged_by": {"$ref": "#/$defs/actor"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "schema",
        "case_id",
        "version",
        "status",
        "scope_sha256",
        "category",
        "severity",
        "observed_at_utc",
        "content_sha256",
        "created_at_utc",
        "updated_at_utc",
        "opened_by",
        "last_updated_by",
        "escalation",
        "emergency_resource_receipt",
        "previous_version_sha256",
        "case_sha256"
      ],
      "properties": {
        "schema": {"const": "teaching_skill_miner.safeguarding_case.v1"},
        "case_id": {"type": "string", "pattern": "^sgc_[0-9a-f]{24}$"},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["open", "acknowledged", "closed"]},
        "scope_sha256": {"$ref": "#/$defs/digest"},
        "category": {
          "enum": [
            "self_harm",
            "abuse_disclosure",
            "bullying_disclosure",
            "minor_sexual_content",
            "urgent_medical",
            "harm_to_others",
            "other_safeguarding"
          ]
        },
        "severity": {"enum": ["elevated", "high", "urgent"]},
        "observed_at_utc": {"$ref": "#/$defs/utc"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "created_at_utc": {"$ref": "#/$defs/utc"},
        "updated_at_utc": {"$ref": "#/$defs/utc"},
        "opened_by": {"$ref": "#/$defs/actor"},
        "last_updated_by": {"$ref": "#/$defs/actor"},
        "escalation": {
          "oneOf": [
            {"$ref": "#/$defs/unavailable_escalation"},
            {"$ref": "#/$defs/configured_escalation"}
          ]
        },
        "emergency_resource_receipt": {"$ref": "#/$defs/resource_receipt"},
        "previous_version_sha256": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "case_sha256": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "schema",
        "sequence",
        "event_id",
        "event_type",
        "occurred_at_utc",
        "idempotency_key_sha256",
        "request_sha256",
        "case_snapshot",
        "actor",
        "previous_event_sha256",
        "event_sha256"
      ],
      "properties": {
        "schema": {"const": "teaching_skill_miner.safeguarding_event.v1"},
        "sequence": {"type": "integer", "minimum": 1},
        "event_id": {"type": "string", "pattern": "^sgev_[0-9a-f]{24}$"},
        "event_type": {
          "enum": [
            "case.opened",
            "case.acknowledged",
            "case.closed",
            "escalation.overdue",
            "escalation.acknowledged"
          ]
        },
        "occurred_at_utc": {"$ref": "#/$defs/utc"},
        "idempotency_key_sha256": {"$ref": "#/$defs/digest"},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "case_snapshot": {"$ref": "#/$defs/case"},
        "actor": {"$ref": "#/$defs/actor"},
        "previous_event_sha256": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "event_sha256": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "erasure_fence": {
      "type": "object",
      "required": [
        "schema",
        "algorithm",
        "generation",
        "bit_count",
        "hash_count",
        "inserted_count",
        "bits_sha256",
        "accumulator_sha256",
        "false_negative_possible",
        "false_positive_policy"
      ],
      "properties": {
        "schema": {
          "const": "teaching_skill_miner.safeguarding_erasure_fence.v2"
        },
        "algorithm": {"const": "bloom_sha256_double_hash_v1"},
        "generation": {"type": "integer", "minimum": 1},
        "bit_count": {"const": 67108864},
        "hash_count": {"const": 7},
        "inserted_count": {"type": "integer", "minimum": 0},
        "bits_sha256": {"$ref": "#/$defs/digest"},
        "accumulator_sha256": {"$ref": "#/$defs/digest"},
        "false_negative_possible": {"const": false},
        "false_positive_policy": {"const": "fail_closed_as_erased"}
      },
      "additionalProperties": false
    },
    "retention_compaction": {
      "type": "object",
      "required": [
        "schema",
        "generation",
        "cases_compacted_total",
        "events_compacted_total",
        "last_compacted_at_utc",
        "last_authorization_receipt_sha256",
        "last_operation_body_sha256",
        "policy_version_sha256",
        "minimum_closed_age_seconds",
        "previous_compaction_sha256",
        "compaction_sha256"
      ],
      "properties": {
        "schema": {
          "const": "teaching_skill_miner.safeguarding_retention_compaction.v1"
        },
        "generation": {"type": "integer", "minimum": 0},
        "cases_compacted_total": {"type": "integer", "minimum": 0},
        "events_compacted_total": {"type": "integer", "minimum": 0},
        "last_compacted_at_utc": {
          "oneOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]
        },
        "last_authorization_receipt_sha256": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "last_operation_body_sha256": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "policy_version_sha256": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "minimum_closed_age_seconds": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 315360000
            },
            {"type": "null"}
          ]
        },
        "previous_compaction_sha256": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "compaction_sha256": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        }
      },
      "oneOf": [
        {
          "properties": {
            "generation": {"const": 0},
            "cases_compacted_total": {"const": 0},
            "events_compacted_total": {"const": 0},
            "last_compacted_at_utc": {"type": "null"},
            "last_authorization_receipt_sha256": {"type": "null"},
            "last_operation_body_sha256": {"type": "null"},
            "policy_version_sha256": {"type": "null"},
            "minimum_closed_age_seconds": {"type": "null"},
            "previous_compaction_sha256": {"type": "null"},
            "compaction_sha256": {"type": "null"}
          }
        },
        {
          "properties": {
            "generation": {"type": "integer", "minimum": 1},
            "cases_compacted_total": {"type": "integer", "minimum": 1},
            "events_compacted_total": {"type": "integer", "minimum": 1},
            "last_compacted_at_utc": {"$ref": "#/$defs/utc"},
            "last_authorization_receipt_sha256": {"$ref": "#/$defs/digest"},
            "last_operation_body_sha256": {"$ref": "#/$defs/digest"},
            "policy_version_sha256": {"$ref": "#/$defs/digest"},
            "minimum_closed_age_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 315360000
            },
            "previous_compaction_sha256": {"$ref": "#/$defs/digest"},
            "compaction_sha256": {"$ref": "#/$defs/digest"}
          }
        }
      ],
      "additionalProperties": false
    },
    "tombstone": {
      "type": "object",
      "required": [
        "schema",
        "case_id_sha256",
        "purged_at_utc",
        "generation",
        "expected_version",
        "idempotency_key_sha256",
        "request_sha256",
        "authorization_receipt_sha256",
        "actor",
        "tombstone_sha256"
      ],
      "properties": {
        "schema": {
          "const": "teaching_skill_miner.safeguarding_erasure_tombstone.v1"
        },
        "case_id_sha256": {"$ref": "#/$defs/digest"},
        "purged_at_utc": {"$ref": "#/$defs/utc"},
        "generation": {"type": "integer", "minimum": 1},
        "expected_version": {"type": "integer", "minimum": 1},
        "idempotency_key_sha256": {"$ref": "#/$defs/digest"},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "authorization_receipt_sha256": {"$ref": "#/$defs/digest"},
        "actor": {"$ref": "#/$defs/actor"},
        "tombstone_sha256": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  }
}
