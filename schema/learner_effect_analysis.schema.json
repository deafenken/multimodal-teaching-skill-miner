{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:learner-effect-analysis:2",
  "title": "Aggregate learner-effect analysis pending external validation",
  "type": "object",
  "required": ["schema", "protocol_version", "study_id", "input_bindings", "design", "primary_analysis", "secondary_analyses", "coverage_and_attrition", "subgroup_and_fairness", "teacher_burden", "blinding_and_safety", "gates", "learner_effect_establishment_gates", "learner_effectiveness_established", "external_validation_status", "external_validation_pending_requirements", "claim_boundary", "external_evidence_handoff", "software"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.learner_effect_analysis.v2"},
    "protocol_version": {"const": "2.0"},
    "study_id": {"$ref": "#/$defs/id"},
    "input_bindings": {"type": "object"},
    "design": {
      "type": "object",
      "required": ["study_design", "analysis_is_intention_to_treat", "intervention_version", "intervention_build_sha256", "external_assessor_registration"],
      "properties": {
        "study_design": {"const": "cluster_randomized_controlled_trial"},
        "analysis_is_intention_to_treat": {"const": true}
      },
      "additionalProperties": true
    },
    "primary_analysis": {"type": "object"},
    "secondary_analyses": {
      "type": "object",
      "required": ["transfer", "retention_2_to_4_weeks"],
      "properties": {
        "transfer": {"type": "object"},
        "retention_2_to_4_weeks": {
          "type": "object",
          "required": ["assessment_window_days"],
          "properties": {"assessment_window_days": {"const": [14, 28]}},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "coverage_and_attrition": {"type": "object"},
    "subgroup_and_fairness": {
      "type": "object",
      "required": ["small_cell_threshold_per_arm", "subgroups", "subgroup_semantics_or_protected_attributes_included", "causal_subgroup_claim_permitted"],
      "properties": {
        "small_cell_threshold_per_arm": {"type": "integer", "minimum": 5},
        "subgroups": {"type": "array"},
        "subgroup_semantics_or_protected_attributes_included": {"const": false},
        "causal_subgroup_claim_permitted": {"const": false}
      },
      "additionalProperties": true
    },
    "teacher_burden": {"type": "object"},
    "blinding_and_safety": {"type": "object"},
    "gates": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "local_preregistered_positive_result_gate": {"type": "boolean"},
    "eligible_for_external_governance_review": {"type": "boolean"},
    "learner_effect_establishment_gates": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "learner_effect_establishment_gate": {"const": false},
    "learner_effectiveness_established": {"const": false},
    "external_validation_status": {"const": "external_validation_pending"},
    "external_validation_pending_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "claim_boundary": {
      "type": "object",
      "required": ["independent_assessor_signature_verified", "semantic_lockbox_binding_verified", "external_governance_signature_verified"],
      "properties": {
        "independent_assessor_signature_verified": {"const": false},
        "semantic_lockbox_binding_verified": {"const": false},
        "external_governance_signature_verified": {"const": false}
      },
      "additionalProperties": true
    },
    "external_evidence_handoff": {"type": "object"},
    "software": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"}
  }
}
