{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_free_text_benchmark_receipt.schema.json",
  "title": "Public aggregate Teacher Agent online development benchmark receipt",
  "type": "object",
  "required": ["schema", "artifact_kind", "run_date", "run_status", "source_report", "input_fingerprints", "configuration", "metrics", "baselines", "privacy", "claim_boundary"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_free_text_benchmark_receipt.v1"},
    "artifact_kind": {"const": "public_aggregate_online_development_benchmark_receipt"},
    "run_date": {"type": "string", "format": "date"},
    "run_status": {"const": "completed"},
    "source_report": {
      "type": "object",
      "required": ["filename", "content_sha256", "run_fingerprint"],
      "properties": {
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.json$"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "run_fingerprint": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "input_fingerprints": {
      "type": "object",
      "required": ["benchmark_sha256", "skill_library_sha256", "protocol_sha256"],
      "properties": {
        "benchmark_sha256": {"$ref": "#/$defs/sha256"},
        "skill_library_sha256": {"$ref": "#/$defs/sha256"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": ["provider", "model", "prompt_version", "thinking_mode", "temperature", "repeat_count", "case_count"],
      "properties": {
        "provider": {"const": "deepseek"},
        "model": {"const": "deepseek-v4-flash"},
        "prompt_version": {"const": "teacher_agent_free_text_diagnose_route_v2"},
        "thinking_mode": {"const": "disabled"},
        "temperature": {"const": 0.0},
        "repeat_count": {"const": 1},
        "case_count": {"const": 28}
      },
      "additionalProperties": false
    },
    "metrics": {"$ref": "#/$defs/numericObject"},
    "baselines": {"$ref": "#/$defs/numericOrBooleanObject"},
    "privacy": {
      "type": "object",
      "required": ["raw_case_text_included", "provider_response_body_included", "api_key_included", "only_aggregate_metrics_and_hashes"],
      "properties": {
        "raw_case_text_included": {"const": false},
        "provider_response_body_included": {"const": false},
        "api_key_included": {"const": false},
        "only_aggregate_metrics_and_hashes": {"const": true}
      },
      "additionalProperties": false
    },
    "claim_boundary": {
      "type": "object",
      "required": ["source_type", "expert_validated", "real_students_involved", "held_out_after_prompt_development", "free_text_diagnostic_accuracy_established", "skill_routing_quality_established", "deployment_accuracy_established", "real_learning_effect_established", "intended_interpretation"],
      "properties": {
        "source_type": {"const": "author_constructed_not_expert_validated"},
        "expert_validated": {"const": false},
        "real_students_involved": {"const": false},
        "held_out_after_prompt_development": {"const": false},
        "free_text_diagnostic_accuracy_established": {"const": false},
        "skill_routing_quality_established": {"const": false},
        "deployment_accuracy_established": {"const": false},
        "real_learning_effect_established": {"const": false},
        "intended_interpretation": {"const": "post-hoc development regression evidence only"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "numericObject": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number"}
    },
    "numericOrBooleanObject": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["number", "boolean"]}
    }
  },
  "additionalProperties": false
}
