{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teaching-skill-miner.local/schema/teacher_agent_remote_consent_receipt.schema.json",
  "title": "Teacher Agent Remote Consent Receipt",
  "type": "object",
  "required": [
    "schema", "consent_id", "subject_id", "purpose", "provider_id",
    "processing_region", "data_categories", "provider_retention_days",
    "policy_version", "guardian_or_school_policy", "provider_policy",
    "provider_policy_sha256", "subject_policy", "subject_policy_sha256", "status",
    "granted_at_utc", "expires_at_utc", "revoked_at_utc",
    "revocation_reason_code", "receipt_sha256", "signature"
  ],
  "properties": {
    "schema": {"const": "teaching_skill_miner.remote_consent_receipt.v1"},
    "consent_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,160}$"},
    "subject_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,160}$"},
    "purpose": {
      "enum": [
        "remote_chat", "remote_teaching", "remote_syllabus_generation",
        "public_web_search", "remote_visual_analysis"
      ]
    },
    "provider_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{2,80}$"},
    "processing_region": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{2,40}$"},
    "data_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "learner_message", "learner_profile_bounded",
          "teaching_resource_excerpt", "public_web_query", "learner_image"
        ]
      }
    },
    "provider_retention_days": {"type": "integer", "minimum": 0, "maximum": 365},
    "provider_policy": {
      "type": "object",
      "required": ["policy_id", "policy_version", "policy_source", "processing_region", "provider_retention_days", "deletion_status", "documentation_url"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,119}$"},
        "policy_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,119}$"},
        "policy_source": {"enum": ["deployment_operator_asserted_external_terms_not_repository_verified", "local_unverified_test_or_standalone"]},
        "processing_region": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{2,40}$"},
        "provider_retention_days": {"type": "integer", "minimum": 0, "maximum": 365},
        "deletion_status": {"enum": ["outside_service_control_subject_to_provider_policy", "provider_documents_zero_retention"]},
        "documentation_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"}
      },
      "additionalProperties": false
    },
    "provider_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_policy": {
      "type": "object",
      "required": ["policy_id", "policy_version", "policy_source", "likely_minor", "guardian_or_school_policy", "remote_processing_eligible"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,119}$"},
        "policy_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,119}$"},
        "policy_source": {"enum": ["organization_oidc_or_roster_policy", "local_unverified_self_declaration"]},
        "likely_minor": {"type": "boolean"},
        "guardian_or_school_policy": {"enum": ["not_required", "verified_guardian", "verified_school_policy"]},
        "remote_processing_eligible": {"const": true}
      },
      "additionalProperties": false
    },
    "subject_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_version": {"const": 1},
    "guardian_or_school_policy": {
      "enum": ["not_required", "verified_guardian", "verified_school_policy"]
    },
    "status": {"enum": ["active", "revoked"]},
    "granted_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "revoked_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "revocation_reason_code": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
