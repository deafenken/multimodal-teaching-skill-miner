{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teaching-skill-miner:schema:external-research-evidence-attestation:1",
  "title": "Ed25519 external research evidence attestation",
  "type": "object",
  "required": [
    "schema_version",
    "protocol",
    "public_key_sha256",
    "statement",
    "signature_base64"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol": {"const": "ed25519_external_research_evidence_attestation_v1"},
    "public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "statement": {
      "type": "object",
      "required": [
        "schema_version",
        "protocol",
        "issuer",
        "key_id",
        "signer_role",
        "signed_at_utc",
        "evidence"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "protocol": {"const": "external_research_evidence_signature_statement_v1"},
        "issuer": {"type": "string", "minLength": 1},
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"
        },
        "signer_role": {"const": "independent_external_research_governance"},
        "signed_at_utc": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "external_research_evidence.schema.json"}
      },
      "additionalProperties": false
    },
    "signature_base64": {"type": "string", "minLength": 80}
  },
  "additionalProperties": false
}
