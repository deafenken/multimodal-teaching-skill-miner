{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_evaluation_report.schema.json",
  "title": "Task-two Teaching Agent evaluation report",
  "type": "object",
  "required": ["schema", "artifact_kind", "skill_library_fingerprint", "evaluation_cases_fingerprint", "baseline", "aggregate", "gates", "passed", "cases", "claim_boundary", "metric_semantics", "content_sha256"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_evaluation.v1"},
    "artifact_kind": {"const": "reproducible_structured_fixture_teacher_agent_evaluation"},
    "skill_library_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_cases_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline": {"type": "object"},
    "aggregate": {
      "type": "object",
      "required": ["case_count", "expected_success_case_count", "expected_unable_case_count", "terminal_decision_match_rate", "student_state_judgement_rate", "teaching_decision_match_rate", "teaching_behavior_quality_rate", "adaptive_multi_skill_case_rate", "adaptive_simulated_mean_gain", "baseline_simulated_mean_gain", "simulated_mean_gain_delta", "adaptive_simulated_transfer_pass_rate", "baseline_simulated_transfer_pass_rate"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 1},
        "expected_success_case_count": {"type": "integer", "minimum": 0},
        "expected_unable_case_count": {"type": "integer", "minimum": 0},
        "terminal_decision_match_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "student_state_judgement_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "teaching_decision_match_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "teaching_behavior_quality_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "adaptive_multi_skill_case_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "adaptive_simulated_mean_gain": {"type": "number"},
        "baseline_simulated_mean_gain": {"type": "number"},
        "simulated_mean_gain_delta": {"type": "number"},
        "adaptive_simulated_transfer_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "baseline_simulated_transfer_pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "gates": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "passed": {"type": "boolean"},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "claim_boundary": {"type": "object"},
    "metric_semantics": {"type": "object", "additionalProperties": {"type": "string"}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
