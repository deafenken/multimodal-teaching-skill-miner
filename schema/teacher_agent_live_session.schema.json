              "model_raw_signal": {"enum": ["not_observed", "correct", "partial", "misconception", "confused", "no_response"]},
              "final_signal": {"enum": ["correct", "partial", "misconception", "confused", "no_response"]},
              "normalization_reasons": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
              "grounding": {"enum": ["verified_current_response_substring", "empty_response_no_excerpt", "no_grounded_excerpt"]},
              "needs_human_review": {"type": "boolean"},
              "review_reasons": {"type": "array", "uniqueItems": true, "items": {"enum": ["low_confidence", "model_requested_review", "deterministic_contract_normalization", "no_grounded_excerpt"]}},
              "privacy_status": {"const": "redacted_before_candidate_storage"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
