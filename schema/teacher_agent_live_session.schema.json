{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_live_session.schema.json",
  "title": "DeepSeek-backed real-time Teaching Agent session",
  "type": "object",
  "required": [
    "schema", "artifact_kind", "status", "policy", "goal", "student_profile",
    "skill_library", "skill_library_fingerprint", "round", "student_state",
    "current_action", "history", "control", "claim_boundary", "goal_plan",
    "teaching_memory", "agent_runtime", "context_memory", "integrity"
  ],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_session.v1"},
    "artifact_kind": {"const": "real_time_deepseek_teaching_agent_session"},
    "status": {"enum": ["active", "succeeded", "terminated_unable"]},
    "policy": {"const": "adaptive_skill_library"},
    "fixed_skill_id": {"type": "null"},
    "goal": {"type": "object"},
    "student_profile": {
      "type": "object",
      "required": ["adaptive_observations", "adaptive_summary"],
      "properties": {
        "adaptive_observations": {"$ref": "#/$defs/adaptiveObservations"},
        "adaptive_summary": {"$ref": "#/$defs/adaptiveSummary"}
      }
    },
    "skill_library": {"type": "object"},
    "skill_library_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "round": {"type": "integer", "minimum": 0},
    "student_state": {
      "type": "object",
      "required": ["knowledge_mastery", "misconceptions", "understanding_signal", "next_focus", "assessment_basis", "interaction_statistics", "assessment_confidence", "assessment_evidence"],
      "properties": {
        "knowledge_mastery": {
          "type": "object",
          "required": ["prerequisite", "conceptual", "procedural", "transfer"],
          "properties": {
            "prerequisite": {"type": "number", "minimum": 0, "maximum": 1},
            "conceptual": {"type": "number", "minimum": 0, "maximum": 1},
            "procedural": {"type": "number", "minimum": 0, "maximum": 1},
            "transfer": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "misconceptions": {"type": "array", "items": {"type": "object"}},
        "understanding_signal": {"type": "object"},
        "next_focus": {"type": "object"},
        "assessment_basis": {"type": "string", "minLength": 1},
        "assessment_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "assessment_evidence": {
          "type": "object",
          "required": ["excerpt", "reason", "source", "needs_human_review"],
          "properties": {
            "excerpt": {"type": "string"},
            "reason": {"type": "string", "minLength": 1},
            "answer_alignment": {"enum": ["not_applicable", "aligned", "partially_aligned", "related_but_not_answer", "contradicted", "ambiguous", "no_response"]},
            "matched_concepts": {"type": "array", "items": {"type": "string"}, "maxItems": 6},
            "missing_concepts": {"type": "array", "items": {"type": "string"}, "maxItems": 6},
            "source": {"type": "string", "minLength": 1},
            "needs_human_review": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "interaction_statistics": {
          "type": "object",
          "required": ["attempt_count", "correct_count", "partial_count", "misconception_count", "confused_count", "no_response_count", "rolling_correct_rate", "average_response_length", "engagement_level", "response_quality"],
          "properties": {
            "attempt_count": {"type": "integer", "minimum": 0},
            "correct_count": {"type": "integer", "minimum": 0},
            "partial_count": {"type": "integer", "minimum": 0},
            "misconception_count": {"type": "integer", "minimum": 0},
            "confused_count": {"type": "integer", "minimum": 0},
            "no_response_count": {"type": "integer", "minimum": 0},
            "rolling_correct_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "average_response_length": {"type": "number", "minimum": 0},
            "engagement_level": {"enum": ["high", "medium", "low", "unknown"]},
            "response_quality": {"enum": ["complete", "partial", "minimal", "off_topic", "empty"]}
          },
          "additionalProperties": false
        },
        "student_model": {"$ref": "#/$defs/studentModel"}
      },
      "additionalProperties": false
    },
    "current_action": {"type": "object"},
    "history": {"type": "array", "items": {"type": "object"}},
    "control": {"type": "object"},
    "claim_boundary": {
      "type": "object",
      "required": ["free_text_answer_processing_enabled", "free_text_answer_grading_established", "structured_signal_source", "student_identity_required", "simulated_evaluation_is_real_learning_effect", "real_learning_effectiveness_established", "deployment_quality_established", "student_text_may_be_sent_to_configured_api", "media_sent_to_model", "learner_image_input_enabled", "learner_image_processing", "raw_image_understanding_by_deepseek"],
      "properties": {
        "free_text_answer_processing_enabled": {"const": true},
        "free_text_answer_grading_established": {"const": false},
        "structured_signal_source": {"const": "deepseek_assessor_or_rule_fallback"},
        "student_identity_required": {"const": false},
        "simulated_evaluation_is_real_learning_effect": {"const": false},
        "real_learning_effectiveness_established": {"const": false},
        "deployment_quality_established": {"const": false},
        "student_text_may_be_sent_to_configured_api": {"const": true},
        "media_sent_to_model": {"const": false},
        "learner_image_input_enabled": {"const": true},
        "learner_image_processing": {"const": "local_ephemeral_ocr_then_text_reasoning"},
        "raw_image_understanding_by_deepseek": {"const": false}
      },
      "additionalProperties": false
    },
    "goal_plan": {
      "type": "object",
      "required": ["schema", "goal", "intermediate_objectives", "active_step", "progress", "claim_boundary"],
      "properties": {
        "schema": {"const": "teaching_skill_miner.teacher_agent_goal_plan.v1"},
        "goal": {"type": "object"},
        "intermediate_objectives": {"type": "array", "minItems": 4, "items": {"type": "object"}},
        "active_step": {"type": ["string", "null"]},
        "status": {"enum": ["active", "completed"]},
        "progress": {"type": "object"},
        "claim_boundary": {"type": "object"}
      },
      "additionalProperties": false
    },
    "teaching_memory": {"$ref": "#/$defs/teachingMemory"},
    "agent_runtime": {
      "type": "object",
      "required": ["schema", "mode", "provider", "model", "prompt_version", "fallback_to_rules", "action_only_repair_enabled", "state_first_route_adjudication_enabled", "agent_loop_enabled", "agent_loop_post_assessment_enabled", "agent_loop_schema", "maximum_agent_steps", "maximum_agent_tool_calls_per_step", "maximum_agent_repeated_tool_calls", "agent_loop_model_retries", "fallback_count", "model_call_count", "action_repair_call_count", "agent_loop_run_count", "agent_loop_model_call_count", "agent_loop_tool_call_count", "agent_loop_retry_count", "agent_loop_fallback_count", "planner_fallback_count", "action_fallback_count", "assessment_failure_count", "consecutive_assessment_failures", "last_agent_loop", "last_model_trace", "last_error", "remote_student_data_opt_in", "api_key_exposed", "context_policy", "input_modalities", "raw_image_model_support", "local_visual_evidence_policy", "last_context_trace"],
      "properties": {
        "schema": {"const": "teaching_skill_miner.deepseek_teacher_runtime.v1"},
        "mode": {"const": "deepseek_live"},
        "provider": {"const": "deepseek"},
        "model": {"const": "deepseek-v4-flash"},
        "prompt_version": {"type": "string", "minLength": 1},
        "fallback_to_rules": {"type": "boolean"},
        "action_only_repair_enabled": {"type": "boolean"},
        "state_first_route_adjudication_enabled": {"type": "boolean"},
        "agent_loop_enabled": {"type": "boolean"},
        "agent_loop_post_assessment_enabled": {"type": "boolean"},
        "agent_loop_schema": {"const": "teaching_skill_miner.teacher_agent_loop.v1"},
        "maximum_agent_steps": {"type": "integer", "minimum": 2, "maximum": 16},
        "maximum_agent_tool_calls_per_step": {"type": "integer", "minimum": 1, "maximum": 6},
        "maximum_agent_repeated_tool_calls": {"type": "integer", "minimum": 1, "maximum": 4},
        "agent_loop_model_retries": {"type": "integer", "minimum": 0, "maximum": 3},
        "fallback_count": {"type": "integer", "minimum": 0},
        "model_call_count": {"type": "integer", "minimum": 0},
        "action_repair_call_count": {"type": "integer", "minimum": 0},
        "agent_loop_run_count": {"type": "integer", "minimum": 0},
        "agent_loop_model_call_count": {"type": "integer", "minimum": 0},
        "agent_loop_tool_call_count": {"type": "integer", "minimum": 0},
        "agent_loop_retry_count": {"type": "integer", "minimum": 0},
        "agent_loop_fallback_count": {"type": "integer", "minimum": 0},
        "planner_fallback_count": {"type": "integer", "minimum": 0},
        "action_fallback_count": {"type": "integer", "minimum": 0},
        "assessment_failure_count": {"type": "integer", "minimum": 0},
        "consecutive_assessment_failures": {"type": "integer", "minimum": 0},
        "last_agent_loop": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/agentLoopTrace"}
          ]
        },
        "last_model_trace": {"type": ["object", "null"]},
        "last_error": {"type": ["string", "null"]},
        "remote_student_data_opt_in": {"const": true},
        "api_key_exposed": {"const": false},
        "context_policy": {"const": "layered_bounded_evidence_linked_v2_continuity_recall"},
        "input_modalities": {
          "const": ["text", "image_via_local_ocr"]
        },
        "raw_image_model_support": {"const": false},
        "local_visual_evidence_policy": {"const": "ephemeral_media_bounded_ocr_text_v1"},
        "last_context_trace": {
          "type": "object",
          "required": ["schema", "content_sha256", "serialized_chars", "max_chars", "retained_recent_turns", "request_outcome", "model_generated_memory_written"],
          "properties": {
            "schema": {"const": "teaching_skill_miner.layered_teacher_context.v1"},
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "serialized_chars": {"type": "integer", "minimum": 1},
            "max_chars": {"type": "integer", "minimum": 6000},
            "retained_recent_turns": {"type": "integer", "minimum": 0, "maximum": 12},
            "request_outcome": {"enum": ["prepared_not_yet_validated", "validated_model_plan", "deterministic_safety_fallback"]},
            "model_generated_memory_written": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "context_memory": {"$ref": "#/$defs/layeredContext"},
    "initial_model_plan": {"type": "object"},
    "integrity": {
      "type": "object",
      "required": ["algorithm", "content_sha256"],
      "properties": {
        "algorithm": {"const": "sha256_canonical_json_without_integrity"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "studentModel": {
      "type": "object",
      "required": ["schema", "version", "prior_strength", "dimensions", "overall", "last_update", "recommended_focus", "claim_boundary"],
      "properties": {
        "schema": {"const": "teaching_skill_miner.student_state_estimate.v1"},
        "version": {"const": 1},
        "prior_strength": {"type": "number", "minimum": 2},
        "dimensions": {
          "type": "object",
          "required": ["prerequisite", "conceptual", "procedural", "transfer"],
          "properties": {
            "prerequisite": {"$ref": "#/$defs/studentModelDimension"},
            "conceptual": {"$ref": "#/$defs/studentModelDimension"},
            "procedural": {"$ref": "#/$defs/studentModelDimension"},
            "transfer": {"$ref": "#/$defs/studentModelDimension"}
          },
          "additionalProperties": false
        },
        "overall": {
          "type": "object",
          "required": ["p_mastery", "uncertainty", "evidence_count"],
          "properties": {
            "p_mastery": {"type": "number", "minimum": 0, "maximum": 1},
            "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
            "evidence_count": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "last_update": {
          "type": "object",
          "required": ["round", "signal", "focus_dimension", "evidence_id", "source", "update_applied", "needs_human_review"],
          "properties": {
            "round": {"type": "integer", "minimum": 0},
            "signal": {"enum": ["not_observed", "correct", "partial", "misconception", "confused", "no_response"]},
            "focus_dimension": {"type": ["string", "null"]},
            "evidence_id": {"type": ["string", "null"]},
            "source": {"type": "string", "minLength": 1},
            "update_applied": {"type": "boolean"},
            "needs_human_review": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "recommended_focus": {
          "type": "object",
          "required": ["dimension", "reason", "confidence", "evidence_refs"],
          "properties": {
            "dimension": {"enum": ["prerequisite", "conceptual", "procedural", "transfer"]},
            "reason": {"type": "string", "minLength": 1},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "evidence_refs": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "claim_boundary": {
          "type": "object",
          "required": ["is_ground_truth", "teacher_prior_overwritten", "free_text_accuracy_established", "uncertainty_is_calibrated_on_external_lockbox"],
          "properties": {
            "is_ground_truth": {"const": false},
            "teacher_prior_overwritten": {"const": false},
            "free_text_accuracy_established": {"const": false},
            "uncertainty_is_calibrated_on_external_lockbox": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "studentModelDimension": {
      "type": "object",
      "required": ["p_mastery", "uncertainty", "alpha", "beta", "evidence_count", "positive_evidence", "negative_evidence", "last_signal", "last_round", "last_evidence_id", "source"],
      "properties": {
        "p_mastery": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0},
        "beta": {"type": "number", "exclusiveMinimum": 0},
        "evidence_count": {"type": "integer", "minimum": 0},
        "positive_evidence": {"type": "integer", "minimum": 0},
        "negative_evidence": {"type": "integer", "minimum": 0},
        "last_signal": {"enum": ["not_observed", "correct", "partial", "misconception", "confused", "no_response"]},
        "last_round": {"type": "integer", "minimum": 0},
        "last_evidence_id": {"type": ["string", "null"]},
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "agentLoopTrace": {
      "type": "object",
      "required": ["schema", "status", "termination_reason", "steps", "model_call_count", "tool_call_count", "retry_count", "selected_skill_id", "supporting_skill_ids", "next_focus", "deterministic_fallback", "bounded_route_completion", "events", "trace_sha256"],
      "properties": {
        "schema": {"const": "teaching_skill_miner.teacher_agent_loop.v1"},
        "status": {"type": "string", "minLength": 1},
        "termination_reason": {"type": "string"},
        "steps": {"type": "integer", "minimum": 0},
        "model_call_count": {"type": "integer", "minimum": 0},
        "tool_call_count": {"type": "integer", "minimum": 0},
        "retry_count": {"type": "integer", "minimum": 0},
        "selected_skill_id": {"type": "string"},
        "supporting_skill_ids": {"type": "array", "maxItems": 2, "items": {"type": "string"}},
        "next_focus": {"type": "string"},
        "deterministic_fallback": {"type": "boolean"},
        "bounded_route_completion": {"type": "boolean"},
        "events": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["type", "step"],
            "properties": {
              "type": {"type": "string", "minLength": 1},
              "step": {"type": "integer", "minimum": 0},
              "attempt": {"type": "integer", "minimum": 1},
              "kind": {"type": "string"},
              "trace": {"type": "object"},
              "error_type": {"type": "string"},
              "call_id": {"type": "string"},
              "tool": {"type": "string"},
              "ok": {"type": "boolean"},
              "reason": {"type": "string"},
              "skill_id": {"type": "string"},
              "next_focus": {"type": "string"},
              "message_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "teachingMemory": {
      "type": "object",
      "required": ["schema", "history_version", "compaction_generation", "fixed_context_fingerprint", "last_observed_round", "preferences", "open_questions", "commitments", "referents", "claim_boundary"],
      "properties": {
        "schema": {"const": "teaching_skill_miner.teaching_memory.v1"},
        "history_version": {"type": "integer", "minimum": 0},
        "compaction_generation": {"type": "integer", "minimum": 0},
        "fixed_context_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "last_observed_round": {"type": "integer", "minimum": 0},
        "preferences": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/memoryItem"}},
        "open_questions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/memoryItem"}},
        "commitments": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/memoryItem"}},
        "referents": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/memoryItem"}},
        "claim_boundary": {"type": "object"}
      },
      "additionalProperties": false
    },
    "memoryItem": {
      "type": "object",
      "required": ["memory_id", "evidence_refs"],
      "properties": {
        "memory_id": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "answer_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "continuityRecallTarget": {
      "type": "object",
      "required": ["kind", "speaker", "source_round", "excerpt", "evidence_refs"],
      "properties": {
        "kind": {
          "enum": [
            "historical_turn",
            "learner_named_alternatives",
            "teacher_named_alternatives",
            "learner_instruction",
            "unresolved_learner_question",
            "learner_future_agenda",
            "teacher_commitment",
            "teacher_question"
          ]
        },
        "speaker": {"enum": ["learner", "teacher", "teacher_profile"]},
        "source_round": {"type": "integer", "minimum": 0},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 400},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      },
      "additionalProperties": false
    },
    "continuityRecall": {
      "type": "object",
      "required": [
        "schema",
        "cue_kind",
        "cue_excerpt",
        "cue_evidence_refs",
        "status",
        "target",
        "instruction",
        "selection_policy",
        "must_not_invent"
      ],
      "properties": {
        "schema": {"const": "teaching_skill_miner.teacher_agent_continuity_recall.v1"},
        "cue_kind": {
          "enum": [
            "explicit_round_reference",
            "semantic_topic_reference",
            "ordinal_reference",
            "earliest_learner_instruction",
            "earlier_unresolved_question",
            "prior_agreement_or_agenda"
          ]
        },
        "cue_excerpt": {"type": "string", "minLength": 1, "maxLength": 240},
        "cue_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "status": {
          "enum": ["resolved_evidence_linked", "unresolved_no_matching_evidence"]
        },
        "target": {
          "anyOf": [
            {"$ref": "#/$defs/continuityRecallTarget"},
            {"type": "null"}
          ]
        },
        "instruction": {"type": "string", "minLength": 1, "maxLength": 320},
        "selection_policy": {"type": "string", "minLength": 1, "maxLength": 120},
        "must_not_invent": {"const": true}
      },
      "oneOf": [
        {
          "properties": {
            "status": {"const": "resolved_evidence_linked"},
            "target": {"$ref": "#/$defs/continuityRecallTarget"}
          }
        },
        {
          "properties": {
            "status": {"const": "unresolved_no_matching_evidence"},
            "target": {"type": "null"}
          }
        }
      ],
      "additionalProperties": false
    },
    "layeredContext": {
      "type": "object",
      "required": ["schema", "snapshot", "fixed_context", "current_plan", "working_memory", "semantic_summary", "knowledge_state", "candidate_long_term_memory", "evidence_ledger", "retrieval", "privacy", "budget", "claim_boundary"],
      "properties": {
        "schema": {"const": "teaching_skill_miner.layered_teacher_context.v1"},
        "snapshot": {
          "type": "object",
          "required": ["kind", "session_round_before_request", "operation", "current_response_present"],
          "properties": {
            "kind": {"const": "bounded_outbound_model_request_context"},
            "session_round_before_request": {"type": "integer", "minimum": 0},
            "operation": {"enum": ["initial_action", "assess_and_act"]},
            "current_response_present": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "fixed_context": {"type": "object"},
        "current_plan": {"type": "object"},
        "working_memory": {
          "type": "object",
          "required": ["current_focus", "current_knowledge_components", "current_learner_response", "current_response_evidence_id", "recent_turns"],
          "properties": {
            "current_focus": {"type": ["string", "null"]},
            "current_knowledge_components": {"type": "array", "maxItems": 12, "items": {"type": "string"}},
            "current_learner_response": {"type": "string"},
            "current_response_evidence_id": {"type": ["string", "null"]},
            "recent_turns": {"type": "array", "maxItems": 12, "items": {"type": "object"}}
          },
          "additionalProperties": false
        },
        "semantic_summary": {
          "type": "object",
          "required": ["turn_count", "focus_checkpoints", "teaching_checkpoints", "compression_method", "source", "narrative_inference_added"],
          "properties": {
            "turn_count": {"type": "integer", "minimum": 0},
            "round_range": {"type": ["array", "null"], "items": {"type": "integer"}},
            "signal_counts": {"type": "object"},
            "focus_counts": {"type": "object"},
            "skill_counts": {"type": "object"},
            "signal_source_counts": {"type": "object"},
            "focus_checkpoints": {"type": "array", "maxItems": 4, "items": {"type": "object"}},
            "teaching_checkpoints": {"type": "array", "maxItems": 6, "items": {"type": "object"}},
            "teaching_memory": {
              "type": "object",
              "required": ["schema", "history_version", "compaction_generation", "fixed_context_fingerprint", "active_preferences", "unresolved_questions", "pending_teacher_commitments", "active_referents", "source", "narrative_inference_added", "model_may_mutate"],
              "properties": {
                "schema": {"const": "teaching_skill_miner.teaching_memory_projection.v1"},
                "history_version": {"type": "integer", "minimum": 0},
                "compaction_generation": {"type": "integer", "minimum": 0},
                "fixed_context_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "active_preferences": {"type": "array", "maxItems": 6, "items": {"type": "object"}},
                "unresolved_questions": {"type": "array", "maxItems": 6, "items": {"type": "object"}},
                "pending_teacher_commitments": {"type": "array", "maxItems": 4, "items": {"type": "object"}},
                "active_referents": {"type": "array", "maxItems": 4, "items": {"type": "object"}},
                "source": {"const": "deterministic_evidence_linked_rollout_projection"},
                "narrative_inference_added": {"const": false},
                "model_may_mutate": {"const": false}
              },
              "additionalProperties": false
            },
            "continuity_recall": {"$ref": "#/$defs/continuityRecall"},
