{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_safeguarding_retention_authorization_receipt.schema.json",
  "title": "Dedicated hash-only safeguarding retention authorization receipt",
  "type": "object",
  "required": [
    "schema",
    "version",
    "actor_kind",
    "server_authenticated",
    "principal_sha256",
    "role_sha256",
    "authorization_context_sha256",
    "operation",
    "body_sha256",
    "issued_at_utc",
    "expires_at_utc",
    "authority_proof_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "teaching_skill_miner.safeguarding_retention_authorization_receipt.v1"
    },
    "version": {"const": 1},
    "actor_kind": {"const": "server_safeguarding_retention"},
    "server_authenticated": {"const": true},
    "principal_sha256": {"$ref": "#/$defs/digest"},
    "role_sha256": {
      "const": "ac64b447f5932780416f75833efc84fd54af7fcb2029bca5857f61ba6e210e30"
    },
    "authorization_context_sha256": {"$ref": "#/$defs/digest"},
    "operation": {"const": "case.retention_compacted"},
    "body_sha256": {"$ref": "#/$defs/digest"},
    "issued_at_utc": {"$ref": "#/$defs/utc"},
    "expires_at_utc": {"$ref": "#/$defs/utc"},
    "authority_proof_sha256": {"$ref": "#/$defs/digest"},
    "receipt_sha256": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
