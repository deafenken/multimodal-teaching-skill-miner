{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_benchmark_v2_predictions.schema.json",
  "title": "Teaching Agent product benchmark v2 private prediction receipt",
  "type": "object",
  "required": ["schema", "benchmark_version", "benchmark_id", "input_fingerprint", "runtime", "cases"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_benchmark_v2_predictions.v1"},
    "benchmark_version": {"const": "2.0"},
    "benchmark_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime": {"type": "object", "additionalProperties": true},
    "cases": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": ["case_id", "session_instance_id", "turns"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"},
        "session_instance_id": {"type": "string", "minLength": 8, "maxLength": 200},
        "final_status": {"type": "string"},
        "turns": {"type": "array", "minItems": 2, "maxItems": 24, "items": {"$ref": "#/$defs/turn"}}
      },
      "additionalProperties": false
    },
    "turn": {
      "type": "object",
      "required": ["turn_id", "teacher_message", "primary_skill_id", "skill_switched", "memory_status", "memory_evidence_turn_ids", "active_misconception_tags", "resolved_misconception_tags", "resolution_evidence_turn_ids", "prompt_injection_blocked", "terminal", "deterministic_fallback"],
      "properties": {
        "turn_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"},
        "teacher_message": {"type": "string", "maxLength": 4000},
        "primary_skill_id": {"type": ["string", "null"]},
        "skill_switched": {"type": "boolean"},
        "memory_status": {"enum": ["not_requested", "resolved_evidence_linked", "unresolved_no_matching_evidence"]},
        "memory_evidence_turn_ids": {"type": "array", "maxItems": 24, "items": {"type": "string"}},
        "active_misconception_tags": {"type": "array", "maxItems": 24, "items": {"type": "string"}},
        "resolved_misconception_tags": {"type": "array", "maxItems": 24, "items": {"type": "string"}},
        "resolution_evidence_turn_ids": {"type": "array", "maxItems": 24, "items": {"type": "string"}},
        "prompt_injection_blocked": {"type": "boolean"},
        "terminal": {"type": "boolean"},
        "deterministic_fallback": {"type": "boolean"},
        "assessment_signal": {"enum": ["not_observed", "correct", "partial", "misconception", "confused", "no_response", "unknown"]},
        "assessment_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "route_changed": {"type": "boolean"},
        "assessment_source": {"type": "string"},
        "loop_summary": {"type": ["object", "null"]},
        "fallback_counts": {
          "type": "object",
          "properties": {
            "agent_loop_fallback_count": {"type": "integer", "minimum": 0},
            "planner_fallback_count": {"type": "integer", "minimum": 0},
            "action_fallback_count": {"type": "integer", "minimum": 0},
            "assessment_failure_count": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "lifecycle_receipt": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    }
  }
}
