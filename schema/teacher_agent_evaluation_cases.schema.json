{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_evaluation_cases.schema.json",
  "title": "Task-two deterministic evaluation cases",
  "type": "object",
  "required": ["schema", "description", "cases", "claim_boundary"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.teacher_agent_evaluation_cases.v1"},
    "description": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "expected_terminal_status", "goal", "student_profile", "feedback_sequence"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "expected_terminal_status": {"enum": ["succeeded", "terminated_unable"]},
          "goal": {"$ref": "#/$defs/goal"},
          "student_profile": {"$ref": "#/$defs/profile"},
          "feedback_sequence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["signal", "response", "expected_skill_ids"],
              "properties": {
                "signal": {"$ref": "#/$defs/signal"},
                "response": {"type": "string"},
                "misconception_tag": {"type": "string", "minLength": 1},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "expected_skill_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "expected_next_focus": {"$ref": "#/$defs/dimension"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "claim_boundary": {
      "type": "object",
      "required": ["fixtures_are_synthetic", "real_students_involved", "free_text_scoring_accuracy_established", "real_learning_effect_established"],
      "properties": {
        "fixtures_are_synthetic": {"const": true},
        "real_students_involved": {"const": false},
        "free_text_scoring_accuracy_established": {"const": false},
        "real_learning_effect_established": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "dimension": {"enum": ["prerequisite", "conceptual", "procedural", "transfer"]},
    "signal": {"enum": ["correct", "partial", "misconception", "confused", "no_response"]},
    "mastery": {
      "type": "object",
      "required": ["prerequisite", "conceptual", "procedural", "transfer"],
      "properties": {
        "prerequisite": {"type": "number", "minimum": 0, "maximum": 1},
        "conceptual": {"type": "number", "minimum": 0, "maximum": 1},
        "procedural": {"type": "number", "minimum": 0, "maximum": 1},
        "transfer": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "required": ["concept", "objective", "success_thresholds", "max_rounds", "materials"],
      "properties": {
        "concept": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "success_thresholds": {"$ref": "#/$defs/mastery"},
        "max_rounds": {"type": "integer", "minimum": 3, "maximum": 50},
        "materials": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["profile_ref", "learner_level", "preferences", "initial_mastery", "known_misconceptions", "conversation_history"],
      "properties": {
        "profile_ref": {"type": "string", "minLength": 1},
        "learner_level": {"type": "string", "minLength": 1},
        "preferences": {"type": "array", "items": {"type": "string"}},
        "initial_mastery": {"$ref": "#/$defs/mastery"},
        "known_misconceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tag", "description", "confidence"],
            "properties": {
              "tag": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
          }
        },
        "conversation_history": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
