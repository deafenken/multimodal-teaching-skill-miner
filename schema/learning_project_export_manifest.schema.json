{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/learning_project_export_manifest.schema.json",
  "title": "Private learning project export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "exported_at", "entry_count", "entries", "claim_boundary"],
  "properties": {
    "schema": {"const": "teaching_skill_miner.project_private_export.v1"},
    "project_id": {"type": "string", "pattern": "^project_[0-9a-f]{24}$"},
    "exported_at": {"type": "string", "format": "date-time"},
    "entry_count": {"type": "integer", "minimum": 1, "maximum": 20000},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "media_type", "data_class", "reference_id"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 600},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"enum": ["application/json", "application/octet-stream"]},
          "data_class": {"type": "string", "minLength": 1, "maxLength": 120},
          "reference_id": {"type": ["string", "null"], "maxLength": 200}
        }
      }
    },
    "claim_boundary": {
      "const": {
        "contains_private_content": true,
        "built_from_public_projection": false,
        "suitable_for_public_release": false
      }
    }
  }
}
