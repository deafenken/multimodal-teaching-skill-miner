{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-skill-miner/teacher_agent_emergency_resource_bundle.schema.json",
  "title": "Versioned emergency-resource localization bundle",
  "type": "object",
  "required": [
    "schema",
    "policy_version",
    "locale_selection_source",
    "configured_locale",
    "effective_locale",
    "localization_status",
    "localization_unavailable",
    "resources"
  ],
  "properties": {
    "schema": {
      "const": "teaching_skill_miner.emergency_resource_bundle.v1"
    },
    "policy_version": {"$ref": "#/$defs/token"},
    "locale_selection_source": {
      "const": "trusted_deployment_scope_mapping"
    },
    "configured_locale": {
      "oneOf": [{"$ref": "#/$defs/locale"}, {"type": "null"}]
    },
    "effective_locale": {
      "anyOf": [
        {"$ref": "#/$defs/locale"},
        {"const": "generic"}
      ]
    },
    "localization_status": {
      "enum": ["localized", "localization_unavailable"]
    },
    "localization_unavailable": {"type": "boolean"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/resource"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"localization_unavailable": {"const": true}},
        "required": ["localization_unavailable"]
      },
      "then": {
        "properties": {
          "localization_status": {"const": "localization_unavailable"},
          "effective_locale": {"const": "generic"}
        }
      },
      "else": {
        "properties": {
          "localization_status": {"const": "localized"},
          "effective_locale": {
            "allOf": [
              {"$ref": "#/$defs/locale"},
              {"not": {"const": "generic"}}
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8}){0,3}$"
    },
    "resource": {
      "type": "object",
      "required": ["kind", "label", "instruction"],
      "properties": {
        "kind": {
          "enum": [
            "emergency_services",
            "crisis_support",
            "trusted_adult",
            "institution_safeguarding"
          ]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      },
      "additionalProperties": false
    }
  }
}
