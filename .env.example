# Default backend is deterministic and requires no API.
TSM_BACKEND=heuristic

# Optional OpenAI-compatible endpoint. Never commit a real key.
TSM_API_BASE=https://api.openai.com/v1
TSM_API_KEY=
TSM_MODEL=gpt-4.1-mini
TSM_TIMEOUT_SECONDS=90
# Required before sending transcript excerpts to a non-local API endpoint.
TSM_ALLOW_REMOTE_TRANSCRIPT_UPLOAD=0

# Task-two real-time Teaching Agent.  The key may be supplied directly through
# DEEPSEEK_API_KEY, but a permission-restricted external key file is preferred.
TSM_DEEPSEEK_BASE_URL=https://api.deepseek.com
TSM_DEEPSEEK_MODEL=deepseek-v4-flash
TSM_DEEPSEEK_API_KEY_FILE=
TSM_DEEPSEEK_TIMEOUT_SECONDS=60
TSM_DEEPSEEK_MAX_RETRIES=2
TSM_DEEPSEEK_THINKING=0
TSM_DEEPSEEK_TEMPERATURE=0
# Must be explicitly enabled before redacted learner text/context is sent.
TSM_ALLOW_REMOTE_STUDENT_DATA=0

# Optional external commands used by `tsm preprocess` for media files.
TSM_FFMPEG=ffmpeg
TSM_FFPROBE=ffprobe
TSM_WHISPER=whisper
TSM_WHISPER_MODEL=base
TSM_WHISPER_DEVICE=
TSM_MEDIA_TIMEOUT_SECONDS=1800
TSM_TESSERACT=tesseract
