# Default backend is deterministic and requires no API.
TSM_BACKEND=heuristic

# Optional OpenAI-compatible endpoint. Never commit a real key.
TSM_API_BASE=https://api.openai.com/v1
TSM_API_KEY=
TSM_MODEL=gpt-4.1-mini
TSM_TIMEOUT_SECONDS=90
# Required before sending transcript excerpts to a non-local API endpoint.
TSM_ALLOW_REMOTE_TRANSCRIPT_UPLOAD=0

# Optional external commands used by `tsm preprocess` for media files.
TSM_FFMPEG=ffmpeg
TSM_FFPROBE=ffprobe
TSM_WHISPER=whisper
TSM_WHISPER_MODEL=base
TSM_WHISPER_DEVICE=
TSM_MEDIA_TIMEOUT_SECONDS=1800
TSM_TESSERACT=tesseract
