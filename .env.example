# Provider configuration. Never commit a real key.
HARNESS_DEEPSEEK_API_KEY_FILE=.private/deepseek_api.txt
HARNESS_DEEPSEEK_BASE_URL=https://api.deepseek.com
HARNESS_DEEPSEEK_MODEL=deepseek-v4-flash
HARNESS_DEEPSEEK_TIMEOUT_SECONDS=60
HARNESS_DEEPSEEK_MAX_RETRIES=2
HARNESS_DEEPSEEK_THINKING=0
HARNESS_DEEPSEEK_TEMPERATURE=0

# Optional state root. The default is ~/.agent-harness.
# AGENT_HARNESS_HOME=/private/path/agent-harness-state

# The provider receives conversation text and bounded tool observations.
# Set to 0 only to make remote execution fail closed.
HARNESS_ALLOW_REMOTE_CONTENT=1
